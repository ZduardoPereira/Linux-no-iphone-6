# Regras do udev para o PC (host) — Linux-no-iphone-6
# Instalar:  sudo cp host/99-linux-no-iphone6.rules /etc/udev/rules.d/ && sudo udevadm control --reload
# Remover:   sudo rm /etc/udev/rules.d/99-linux-no-iphone6.rules

# iPhone 6 rodando Linux (nosso gadget USB, 1d6b:0104):
#  - ModemManager não deve tratar a porta serial como modem (mandava "AT" no shell)
#  - o usuário logado pode abrir /dev/ttyACM* sem sudo
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0104", ATTRS{manufacturer}=="Linux-no-iphone-6", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0104", ATTRS{manufacturer}=="Linux-no-iphone-6", ENV{ID_MM_DEVICE_IGNORE}="1"
