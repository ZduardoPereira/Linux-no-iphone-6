diff --git a/src/start.S b/src/start.S
index aa11e18..7a97583 100644
--- a/src/start.S
+++ b/src/start.S
@@ -147,6 +147,19 @@ exc_unk:
 .globl cpu_reset
 .type cpu_reset, @function
 cpu_reset:
+    /* Linux-no-iphone-6 (diagnóstico do 2º núcleo): pegada 0x11 + CurrentEL e, em
+     * EL3, o SCR_EL3 com que o núcleo acordou. MMU desligada: vai direto para a RAM. */
+    ldr x10, =0x83e8fff00
+    mrs x11, CurrentEL
+    lsl x12, x11, #8
+    add x12, x12, #0x11
+    str x12, [x10]
+    cmp x11, #0xc
+    b.ne 1f
+    mrs x12, scr_el3
+    str x12, [x10, #8]
+1:
+    dsb sy
     mov w0, 'O'
     bl debug_putc
 
@@ -185,6 +198,12 @@ el3_eret_to_el1:
     orr x8, x8, #(1<<10) // EL1 execution state is AArch64
     orr x8, x8, #(1<<0)  // EL1 is non-secure
     msr scr_el3, x8
+    /* Linux-no-iphone-6: pegada 0x22 + o SCR_EL3 que vamos usar para descer a EL1 */
+    ldr x10, =0x83e8fff00
+    mov x11, #0x22
+    str x11, [x10, #0x10]
+    str x8, [x10, #0x18]
+    dsb sy
     msr elr_el3, x7 // Set EL1 entry point
     mov x8, #0x5 // EL1h
     msr spsr_el3, x8
