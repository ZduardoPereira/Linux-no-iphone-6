#!/bin/sh
# /init — 1º estágio do boot, dentro do initramfs (que veio pelo USB, na RAM).
#
# Monta a flash interna e passa o sistema para lá (switch_root) para que o que se
# instala e configura no iPhone (apk add, arquivos em /root...) fique salvo:
#   1º boot:    copia este sistema da RAM para /mnt/flash/sistema (flash-linux instalar)
#   todo boot:  recopia a "camada do projeto" (módulos do kernel, firmwares, nossos
#               programas e scripts), para valer sempre o que foi compilado no PC
# Sem flash (ou com "ram" ou "semflash" na linha de comando do kernel), o sistema
# continua na RAM, como antes. O resto do boot é o 2º estágio: iphone6-init.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc  proc  /proc
mount -t sysfs sysfs /sys

ESTAGIO2=/usr/local/sbin/iphone6-init
NOVA=/nova-raiz

na_ram() {
  echo "init: $1 -> sistema na RAM"
  mountpoint -q /mnt/flash && umount /mnt/flash
  exec "$ESTAGIO2"
}

grep -qw -e ram -e semflash /proc/cmdline && na_ram "pedido na linha de comando"
echo "init: montando a flash interna..."
flash-linux montar || na_ram "flash não montou"

if [ ! -e /mnt/flash/sistema/bin/busybox ]; then
  echo "init: 1º boot com a flash: instalando o sistema"
  flash-linux instalar || na_ram "instalação falhou"
fi
flash-linux atualizar || na_ram "atualização falhou"
[ -x "/mnt/flash/sistema$ESTAGIO2" ] || na_ram "sistema na flash incompleto"

# raiz nova = /mnt/flash/sistema; o ext4 inteiro continua visível em /mnt/flash
mkdir -p "$NOVA"
mount --bind /mnt/flash/sistema "$NOVA" || na_ram "bind falhou"
mount --move /mnt/flash "$NOVA/mnt/flash"
mount --move /dev  "$NOVA/dev"
mount --move /proc "$NOVA/proc"
mount --move /sys  "$NOVA/sys"
echo "init: sistema na flash interna"
# switch_root apaga o initramfs (libera a RAM) e roda o 2º estágio como PID 1
exec switch_root "$NOVA" "$ESTAGIO2"
