#!/bin/sh
# /init — primeiro programa que o kernel executa (PID 1).
# Se este script terminar, o kernel entra em pânico; por isso o laço no final.

# o kernel dá um PATH mínimo; os nossos programas ficam em /usr/local
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t configfs configfs /sys/kernel/config
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs    tmpfs    /tmp
hostname -F /etc/hostname

echo
echo "=========================================="
echo "  Linux no iPhone 6 — $(uname -r)"
echo "=========================================="

. /etc/iphone6/usb-gadget.sh

# SSH (dropbear): chaves do servidor geradas na hora (-R); login só com a chave do projeto
mkdir -p /etc/dropbear
dropbear -R -s -E 2>/tmp/dropbear.log && echo "SSH: ./scripts/ssh.sh (root@$(cat /etc/iphone6/phone_ip))"

# Shell na porta serial USB (no PC: ./scripts/07-conectar.sh)
( while true; do
    [ -e /dev/ttyGS0 ] && setsid sh -c 'exec /bin/sh -l </dev/ttyGS0 >/dev/ttyGS0 2>&1'
    sleep 1
  done ) &

# Tela inicial (LVGL, device/inicio). Espera o touch (o driver carrega o firmware
# em segundo plano) e a reinicia se cair. Para voltar ao texto na tela:
#   touch /tmp/sem-inicio; killall inicio
( for i in $(seq 20); do
    grep -qs "touchscreen" /sys/class/input/event*/device/name && break
    sleep 0.5
  done
  while [ ! -e /tmp/sem-inicio ]; do
    /usr/local/bin/inicio >/tmp/inicio.log 2>&1
    sleep 2
  done ) &

# Flash interna: monta o ext4 da janela em /mnt/flash, em segundo plano. Não formata
# nada sozinho. O driver põe o ANS para dormir 2 s depois do último uso, e é isso
# que deixa desligar sem aviso. Para pular: "semflash" na linha de comando do kernel.
if ! grep -qw semflash /proc/cmdline; then
  ( echo "montando..." > /tmp/flash-estado
    if flash-linux montar > /tmp/flash.log 2>&1; then
      echo ok > /tmp/flash-estado
    else
      echo "erro (ver /tmp/flash.log)" > /tmp/flash-estado
    fi ) &
fi

echo "Pronto. No PC: ./scripts/07-conectar.sh"
echo "IP do iPhone: $(cat /etc/iphone6/phone_ip)"

# Mantém o PID 1 vivo; o shell no console aparece quando a tela inicial não está rodando
while true; do /bin/sh -l; done
