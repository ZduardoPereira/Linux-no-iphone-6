#!/bin/sh
# wifi — Wi-Fi do iPhone 6 (Broadcom BCM4345 no PCIe do A8, driver brcmfmac).
#   wifi ligar             carrega os drivers na ordem certa e liga a wlan0
#   wifi redes             procura redes (nome, sinal, canal)
#   wifi conectar "Nome"   pede a senha (sem mostrar), conecta e pega IP por DHCP
#   wifi estado            rede atual, sinal e endereço
#   wifi desligar          desconecta e descarrega o driver do Wi-Fi
#
# A ordem importa: a DART (IOMMU) do PCIe só responde depois que a porta 1 do
# PCIe liga, então apple-dart carrega depois do pcie-apple, e o brcmfmac por último.
# Redes salvas: /etc/wpa_supplicant/wpa_supplicant.conf (a senha fica guardada lá).
set -e
CONF=/etc/wpa_supplicant/wpa_supplicant.conf

liga() {
    [ -e /sys/class/net/wlan0 ] && { ip link set wlan0 up; return; }
    modprobe pcie-apple
    for i in $(seq 20); do [ -e /sys/bus/pci/devices/0000:01:00.0 ] && break; sleep 0.25; done
    [ -e /sys/bus/pci/devices/0000:01:00.0 ] || { echo "wifi: o chip não apareceu no PCIe"; exit 1; }
    modprobe apple-dart
    modprobe brcmfmac
    for i in $(seq 40); do [ -e /sys/class/net/wlan0 ] && break; sleep 0.25; done
    [ -e /sys/class/net/wlan0 ] || { echo "wifi: a wlan0 não apareceu (dmesg | grep brcmfmac)"; exit 1; }
    ip link set wlan0 up
}

case "$1" in
ligar)
    liga
    echo "wifi: wlan0 ligada ($(cat /sys/class/net/wlan0/address))"
    ;;
redes)
    liga
    # nome<TAB>sinal<TAB>frequência, do sinal mais forte para o mais fraco
    iw dev wlan0 scan 2>/dev/null | awk '
        /^BSS / { if (ssid != "") print sinal "\t" freq "\t" ssid; ssid = ""; sinal = ""; freq = "" }
        /\tfreq:/ { freq = $2 }
        /\tsignal:/ { sinal = $2 }
        /\tSSID:/ { sub(/^[ \t]*SSID: /, ""); ssid = $0 }
        END { if (ssid != "") print sinal "\t" freq "\t" ssid }' |
    sort -t "$(printf '\t')" -k1,1nr | awk -F '\t' '
        !visto[$3]++ { printf "%6s dBm  %s MHz  %s\n", $1, $2, $3 }' |
    # o iw escapa bytes fora do ASCII (\xc3\xa9 = é): devolve os acentos
    while IFS= read -r l; do printf '%b\n' "$l"; done
    ;;
conectar)
    [ -n "$2" ] || { echo "uso: wifi conectar \"nome da rede\""; exit 1; }
    liga
    mkdir -p /etc/wpa_supplicant
    [ -f "$CONF" ] || printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\n' > "$CONF"
    chmod 600 "$CONF"
    if ! grep -qF "ssid=\"$2\"" "$CONF"; then
        printf 'Senha de "%s": ' "$2"
        stty -echo 2>/dev/null; read -r SENHA; stty echo 2>/dev/null; echo
        # wpa_passphrase guarda só a chave derivada (psk=...), não a senha em texto
        wpa_passphrase "$2" "$SENHA" | grep -v '^\s*#psk=' >> "$CONF" ||
            { echo "wifi: senha inválida (8 a 63 caracteres)"; exit 1; }
        unset SENHA
    fi
    killall wpa_supplicant 2>/dev/null || true
    mkdir -p /run/wpa_supplicant
    wpa_supplicant -B -i wlan0 -c "$CONF" -s >/dev/null
    printf "wifi: conectando"
    for i in $(seq 30); do
        iw dev wlan0 link | grep -q "^Connected" && break
        printf "."; sleep 1
    done
    echo
    iw dev wlan0 link | grep -q "^Connected" || { echo "wifi: não conectou (senha errada? veja: logread / dmesg)"; exit 1; }
    # a rota padrão passa a ser o Wi-Fi (o SSH pelo cabo continua: rede 172.16.42.0/24)
    ip route del default dev usb0 2>/dev/null || true
    # o udhcpc pega o endereço e fica em segundo plano para renová-lo antes de vencer
    # (sem isso, quando acaba o "aluguel" que o roteador deu, a internet cai).
    # O ^ é importante: só o processo cujo comando COMEÇA com udhcpc; sem ele, o pkill
    # mataria também qualquer shell que tivesse esse texto no próprio comando.
    pkill -f '^udhcpc -i wlan0' 2>/dev/null || true
    udhcpc -i wlan0 -t 10 -n >/dev/null 2>&1 || { echo "wifi: conectou, mas o DHCP não respondeu"; exit 1; }
    "$0" estado
    ;;
estado)
    if [ ! -e /sys/class/net/wlan0 ]; then echo "wifi: desligado"; exit 0; fi
    iw dev wlan0 link | sed -n 's/^Connected to \(.*\) (on wlan0)/rede (BSSID): \1/p;
        s/^\tSSID: /nome: /p; s/^\tsignal: /sinal: /p; s/^\ttx bitrate: /velocidade: /p'
    ip -4 addr show wlan0 | sed -n 's/^ *inet \([^ ]*\).*/endereço: \1/p'
    iw dev wlan0 link | grep -q "^Connected" || echo "não conectado"
    ;;
desligar)
    killall wpa_supplicant udhcpc 2>/dev/null || true
    [ -e /sys/class/net/wlan0 ] && ip link set wlan0 down
    rmmod brcmfmac_wcc brcmfmac 2>/dev/null || true
    echo "wifi: desligado"
    ;;
*)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
