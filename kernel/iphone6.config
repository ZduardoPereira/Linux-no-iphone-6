
# ---- Ajustes do projeto Linux-no-iphone-6 (anexados ao config da Hoolock) ----
# Texto do kernel na tela do iPhone
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# USB do iPhone vira "porta serial" + "placa de rede" para o PC
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
# /dev/i2c-* para o i2cdetect/i2cget (fase 4: achar o chip de vibração)
CONFIG_I2C_CHARDEV=y
# Gadget "legado" embutido que tomava o controlador USB antes do nosso (e falhava)
# CONFIG_USB_G_MULTI is not set
# Initramfs comprimido com gzip
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# Base para a fase Android (ver docs/ROTEIRO.md, fase 6)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# Fase 4: motor de vibração (TI DRV2604) via force-feedback
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_DRV260X_HAPTICS=y
# Fase 4.2: nosso driver dos sensores de temperatura do A8 (kernel/patches/0004)
CONFIG_HWMON=y
CONFIG_SENSORS_APPLE_T7000_TEMP=y
# Fase 4.3: nosso driver do carregador SN2400 (kernel/patches/0005)
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_SN2400=y
# Fase 4.4: nosso driver do medidor de bateria bq27540 por HDQ (kernel/patches/0007)
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_APPLE_HDQ=y
# Fase 5 (touch, T1): SPI do A8 (variante S5L do spi-apple) + spidev para o protótipo
CONFIG_SPI_APPLE=y
CONFIG_SPI_SPIDEV=y
# Fase 5 (touch, T5): nosso driver do chip N1 (kernel/patches/0010)
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_APPLE_N1=y
CONFIG_FW_LOADER=y
# Fase 7: armazenamento interno (ANS1, kernel/patches/0011-0012). O driver NVMe da Apple
# é do A11 em diante; sem ele, mailbox e RTKit viram módulos e dá para testar o
# driver novo com insmod/rmmod pelo SSH, sem reiniciar o iPhone.
# CONFIG_NVME_APPLE is not set
# Também usam o RTKit, mas são de outros chips (PMP do A11, SMC dos Macs)
# CONFIG_APPLE_PMP_T8015_V1 is not set
# CONFIG_MFD_MACSMC is not set
CONFIG_APPLE_MAILBOX=m
CONFIG_APPLE_RTKIT=m
CONFIG_BLK_DEV_APPLE_ANS1=m
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# .ko sem compressão: o insmod/modprobe do busybox não abre .zst
CONFIG_MODULE_COMPRESS=n
CONFIG_MODULE_COMPRESS_NONE=y
# CONFIG_MODULE_COMPRESS_ZSTD is not set

# Wi-Fi (BCM4345 no PCIe do A8, fase 8). PCIe e DART como módulos: a DART do apcie só
# responde depois que a porta 1 do PCIe liga, então ela carrega depois do pcie-apple.
# O controlador PCIe do A8 tem a campainha das MSIs fixa em 0xbffff000.
CONFIG_PCIE_APPLE=m
CONFIG_PCIE_APPLE_MSI_DOORBELL_ADDR=0xbffff000
CONFIG_APPLE_DART=m
CONFIG_GPIO_APPLE_PMIC=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_RFKILL=m
# CONFIG_BRCMDBG is not set
