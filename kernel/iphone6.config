
# ---- Ajustes do projeto Linux-no-iphone-6 (anexados ao config da Hoolock) ----
# Texto do kernel na tela do iPhone
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# USB do iPhone vira "porta serial" + "placa de rede" para o PC
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
# /dev/i2c-* para o i2cdetect/i2cget (fase 4: achar o chip de vibração)
CONFIG_I2C_CHARDEV=y
# Gadget "legado" embutido que tomava o controlador USB antes do nosso (e falhava)
# CONFIG_USB_G_MULTI is not set
# Initramfs comprimido com gzip
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# Base para a fase Android (ver docs/ROTEIRO.md, fase 6)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# Fase 4: motor de vibração (TI DRV2604) via force-feedback
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_DRV260X_HAPTICS=y
# Fase 4.2: nosso driver dos sensores de temperatura do A8 (kernel/patches/0004)
CONFIG_HWMON=y
CONFIG_SENSORS_APPLE_T7000_TEMP=y
# Fase 4.3: nosso driver do carregador SN2400 (kernel/patches/0005)
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_SN2400=y
# Fase 4.4: nosso driver do medidor de bateria bq27540 por HDQ (kernel/patches/0007)
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_APPLE_HDQ=y
