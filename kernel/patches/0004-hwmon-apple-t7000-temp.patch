hwmon: driver novo para os sensores de temperatura do Apple A8 (fase 4.2)

drivers/hwmon/apple-t7000-temp.c + Kconfig/Makefile + nós no device tree do iPhone 6.
Formato do registrador descoberto por engenharia reversa (ver comentário no driver).

--- a/arch/arm64/boot/dts/apple/t7000-n61.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n61.dts
@@ -33,3 +33,24 @@
 		vib-overdrive-mv = <3320>;
 	};
 };
+
+/*
+ * Sensores de temperatura do chip A8 (Linux-no-iphone-6, fase 4.2).
+ * Do ADT da Apple (arm-io/tempsensor0..4): offsets "sensor-offset-readBK".
+ * Driver: drivers/hwmon/apple-t7000-temp.c
+ */
+&{/soc} {
+	temperature-sensor@20e02b000 {
+		compatible = "apple,t7000-tempsensor";
+		reg = <0x2 0x0e02b000 0x0 0x1000>;
+		apple,sensor-offsets = <0x18 0x5c>;
+		apple,sensor-names = "SoC die 0", "SoC die 1";
+	};
+
+	temperature-sensor@202230000 {
+		compatible = "apple,t7000-tempsensor";
+		reg = <0x2 0x02230000 0x0 0x1000>;
+		apple,sensor-offsets = <0x20 0x60 0x220>;
+		apple,sensor-names = "CPU (TCC) 0", "CPU (TCC) 1", "CPU (TCC) 2";
+	};
+};
