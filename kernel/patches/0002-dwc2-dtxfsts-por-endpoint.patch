dwc2: ler DTXFSTS pelo número do endpoint, não do FIFO

DTXFSTSn (0x918 + n*0x20) fica no bloco de registradores do endpoint IN n e
informa o espaço livre no TxFIFO atribuído a ESSE endpoint. O driver passava
fifo_index; quando fifo_index != index (ex.: ep5 usando o FIFO 4 no iPhone 6),
lia o status de outro endpoint, achava 0 bytes livres e nunca escrevia os dados.
Só aparece em modo PIO (sem DMA) com FIFOs dedicados.

diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
index 102169b40..b6cc08146 100644
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -562,7 +562,7 @@ static int dwc2_hsotg_write_fifo(struct dwc2_hsotg *hsotg,
 		}
 	} else if (hsotg->dedicated_fifos && hs_ep->index != 0) {
 		can_write = dwc2_readl(hsotg,
-				       DTXFSTS(hs_ep->fifo_index));
+				       DTXFSTS(hs_ep->index));
 
 		can_write &= 0xffff;
 		can_write *= 4;
@@ -3299,7 +3299,7 @@ static void kill_all_requests(struct dwc2_hsotg *hsotg,
 
 	if (!hsotg->dedicated_fifos)
 		return;
-	size = (dwc2_readl(hsotg, DTXFSTS(ep->fifo_index)) & 0xffff) * 4;
+	size = (dwc2_readl(hsotg, DTXFSTS(ep->index)) & 0xffff) * 4;
 	if (size < ep->fifo_size)
 		dwc2_hsotg_txfifo_flush(hsotg, ep->fifo_index);
 }
