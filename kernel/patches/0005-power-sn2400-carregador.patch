power: driver novo para o carregador TI SN2400 do iPhone 6 (fase 4.3)

diff --git a/arch/arm64/boot/dts/apple/t7000-n61.dts b/arch/arm64/boot/dts/apple/t7000-n61.dts
index 0988976..8c3f404 100644
--- a/arch/arm64/boot/dts/apple/t7000-n61.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n61.dts
@@ -32,6 +32,17 @@
 		vib-rated-mv = <2140>;
 		vib-overdrive-mv = <3320>;
 	};
+
+	/*
+	 * Carregador TI SN2400 "Tigris" (fase 4.3), ADT: arm-io/i2c1/tigris.
+	 * 450 mA = o limite que o iBoot programa (cabe nos 500 mA de uma porta USB 2.0).
+	 * Driver: drivers/power/supply/sn2400_charger.c
+	 */
+	charger@75 {
+		compatible = "ti,sn2400";
+		reg = <0x75>;
+		input-current-limit-microamp = <450000>;
+	};
 };
 
 /*
diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
