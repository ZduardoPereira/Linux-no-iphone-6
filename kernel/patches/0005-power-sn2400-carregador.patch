diff --git b/drivers/power/supply/sn2400_charger.c b/drivers/power/supply/sn2400_charger.c
new file mode 100644
index 0000000..cfe5af1
--- /dev/null
+++ b/drivers/power/supply/sn2400_charger.c
@@ -0,0 +1,354 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Carregador TI SN2400 ("Tigris") do iPhone 6 — i2c1, endereço 0x75.
+ *
+ * Projeto Linux-no-iphone-6, fase 4.3. Chip feito sob medida para a Apple, sem
+ * datasheet. Mapa de registradores: medições nossas + engenharia reversa do driver do
+ * iOS 12.5.5 feita por github.com/ITSMEFRTRUST/linux-on-iphone6 (re/SN2400.md).
+ * Detalhes e o que foi conferido: docs/SN2400.md do projeto.
+ *
+ *   0x04..0x06  eventos (zeram ao ler)
+ *   0x07        status; bit 0 = VBUS presente
+ *   0x09        limite de corrente de ENTRADA: mA = 90 + 10 * código (0..0xBF)
+ *   0x10        configuração; 0x04 = normal, bit 3 = entrada desligada (Hi-Z)
+ *   0x11/0x12   ADC: escrever (canal & 0xE) | 0x10, esperar o bit 4 zerar, ler 0x12
+ *               canal 0 = VBUS (25 mV), 2 = corrente de entrada (7,8 mA),
+ *               6 = bateria (2500 mV + 10 mV)
+ *
+ * Problema que o driver resolve: ao reconectar o cabo, o chip volta o 0x09 para 0
+ * (90 mA) e o iPhone passa a viver da bateria. O iOS reprograma a cada conexão; aqui
+ * um "vigia" (delayed_work a cada 2 s) faz o mesmo. Não há interrupção: a linha IRQ
+ * do chip vai para o PMIC D2186, que ainda não tem driver.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/workqueue.h>
+
+#define SN2400_EVENT1		0x04
+#define SN2400_STATUS		0x07
+#define  SN2400_STATUS_VBUS	BIT(0)
+#define SN2400_ILIM		0x09
+#define SN2400_CONFIG		0x10
+#define  SN2400_CONFIG_NORMAL	0x04
+#define  SN2400_CONFIG_HIZ	BIT(3)
+#define SN2400_ADC_CTRL		0x11
+#define  SN2400_ADC_START	BIT(4)
+#define SN2400_ADC_DATA		0x12
+
+#define SN2400_ADC_VBUS		0
+#define SN2400_ADC_IBUS		2
+#define SN2400_ADC_VBAT		6
+
+#define SN2400_ILIM_MIN_UA	90000
+#define SN2400_ILIM_MAX_UA	2000000
+#define SN2400_ILIM_STEP_UA	10000
+#define SN2400_VBUS_OK_UV	4500000		/* abaixo disso, a fonte é fraca: não insistir */
+#define SN2400_POLL_MS		2000
+
+struct sn2400 {
+	struct i2c_client *client;
+	struct power_supply *usb;
+	struct power_supply *bat;
+	struct delayed_work poll;
+	struct mutex lock;		/* serializa o ADC e as escritas */
+	u32 ilim_ua;			/* limite de entrada desejado */
+	bool online;
+};
+
+static int sn2400_read(struct sn2400 *c, u8 reg)
+{
+	return i2c_smbus_read_byte_data(c->client, reg);
+}
+
+static int sn2400_write(struct sn2400 *c, u8 reg, u8 val)
+{
+	return i2c_smbus_write_byte_data(c->client, reg, val);
+}
+
+/* Faz uma conversão no ADC do chip e devolve o valor bruto (0..255) */
+static int sn2400_adc(struct sn2400 *c, unsigned int canal)
+{
+	int ret, i;
+
+	mutex_lock(&c->lock);
+	ret = sn2400_write(c, SN2400_ADC_CTRL, (canal & 0xe) | SN2400_ADC_START);
+	for (i = 0; ret >= 0 && i < 20; i++) {
+		ret = sn2400_read(c, SN2400_ADC_CTRL);
+		if (ret >= 0 && !(ret & SN2400_ADC_START))
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (ret >= 0)
+		ret = (ret & SN2400_ADC_START) ? -ETIMEDOUT :
+		      sn2400_read(c, SN2400_ADC_DATA);
+	mutex_unlock(&c->lock);
+	return ret;
+}
+
+static int sn2400_vbus_uv(struct sn2400 *c)
+{
+	int v = sn2400_adc(c, SN2400_ADC_VBUS);
+
+	return v < 0 ? v : v * 25000;
+}
+
+static int sn2400_set_ilim(struct sn2400 *c, u32 ua)
+{
+	u8 codigo;
+	int ret;
+
+	ua = clamp(ua, (u32)SN2400_ILIM_MIN_UA, (u32)SN2400_ILIM_MAX_UA);
+	codigo = (ua - SN2400_ILIM_MIN_UA) / SN2400_ILIM_STEP_UA;
+
+	mutex_lock(&c->lock);
+	ret = sn2400_write(c, SN2400_CONFIG, SN2400_CONFIG_NORMAL);	/* tira do Hi-Z */
+	if (!ret)
+		ret = sn2400_write(c, SN2400_ILIM, codigo);
+	mutex_unlock(&c->lock);
+	return ret;
+}
+
+/* O "vigia": roda a cada 2 s */
+static void sn2400_poll(struct work_struct *work)
+{
+	struct sn2400 *c = container_of(work, struct sn2400, poll.work);
+	int status, ilim, cfg, vbus;
+	bool online;
+
+	/* lê (e assim zera) os 3 registradores de eventos */
+	sn2400_read(c, SN2400_EVENT1);
+	sn2400_read(c, SN2400_EVENT1 + 1);
+	sn2400_read(c, SN2400_EVENT1 + 2);
+
+	status = sn2400_read(c, SN2400_STATUS);
+	if (status < 0)
+		goto fim;
+	online = status & SN2400_STATUS_VBUS;
+
+	if (online) {
+		ilim = sn2400_read(c, SN2400_ILIM);
+		cfg = sn2400_read(c, SN2400_CONFIG);
+		vbus = sn2400_vbus_uv(c);
+		/* o chip voltou ao mínimo (cabo reconectado) e a fonte aguenta: reprograma */
+		if (ilim >= 0 && cfg >= 0 && vbus >= SN2400_VBUS_OK_UV &&
+		    (ilim == 0 || (cfg & SN2400_CONFIG_HIZ))) {
+			dev_info(&c->client->dev,
+				 "limite de entrada voltou a 90 mA; reprogramando %u mA (VBUS %d mV)\n",
+				 c->ilim_ua / 1000, vbus / 1000);
+			sn2400_set_ilim(c, c->ilim_ua);
+		}
+	}
+
+	if (online != c->online) {
+		c->online = online;
+		dev_info(&c->client->dev, "cabo %s\n",
+			 online ? "conectado" : "desconectado");
+		power_supply_changed(c->usb);
+		power_supply_changed(c->bat);
+	}
+fim:
+	schedule_delayed_work(&c->poll, msecs_to_jiffies(SN2400_POLL_MS));
+}
+
+/* ---- fonte "usb" (o carregador) ---- */
+
+static const enum power_supply_property sn2400_usb_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+};
+
+static int sn2400_usb_get(struct power_supply *psy,
+			  enum power_supply_property psp,
+			  union power_supply_propval *val)
+{
+	struct sn2400 *c = power_supply_get_drvdata(psy);
+	int r;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		r = sn2400_read(c, SN2400_STATUS);
+		if (r < 0)
+			return r;
+		val->intval = !!(r & SN2400_STATUS_VBUS);
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		r = sn2400_vbus_uv(c);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		r = sn2400_adc(c, SN2400_ADC_IBUS);
+		if (r >= 0)
+			r *= 7800;
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		r = sn2400_read(c, SN2400_ILIM);
+		if (r >= 0)
+			r = SN2400_ILIM_MIN_UA + r * SN2400_ILIM_STEP_UA;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (r < 0)
+		return r;
+	val->intval = r;
+	return 0;
+}
+
+static int sn2400_usb_set(struct power_supply *psy,
+			  enum power_supply_property psp,
+			  const union power_supply_propval *val)
+{
+	struct sn2400 *c = power_supply_get_drvdata(psy);
+
+	if (psp != POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT || val->intval < 0)
+		return -EINVAL;
+	c->ilim_ua = clamp_t(u32, val->intval, SN2400_ILIM_MIN_UA,
+			     SN2400_ILIM_MAX_UA);
+	return sn2400_set_ilim(c, c->ilim_ua);
+}
+
+static int sn2400_usb_writeable(struct power_supply *psy,
+				enum power_supply_property psp)
+{
+	return psp == POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT;
+}
+
+static const struct power_supply_desc sn2400_usb_desc = {
+	.name = "sn2400-usb",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = sn2400_usb_props,
+	.num_properties = ARRAY_SIZE(sn2400_usb_props),
+	.get_property = sn2400_usb_get,
+	.set_property = sn2400_usb_set,
+	.property_is_writeable = sn2400_usb_writeable,
+};
+
+/* ---- fonte "battery" (só o que o carregador sabe medir) ---- */
+
+static const enum power_supply_property sn2400_bat_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+};
+
+static int sn2400_bat_get(struct power_supply *psy,
+			  enum power_supply_property psp,
+			  union power_supply_propval *val)
+{
+	struct sn2400 *c = power_supply_get_drvdata(psy);
+	int r;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		/* aproximação: sem o medidor de bateria não dá para saber "cheia" */
+		val->intval = c->online ? POWER_SUPPLY_STATUS_CHARGING :
+					  POWER_SUPPLY_STATUS_DISCHARGING;
+		return 0;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		r = sn2400_adc(c, SN2400_ADC_VBAT);
+		if (r < 0)
+			return r;
+		val->intval = 2500000 + r * 10000;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct power_supply_desc sn2400_bat_desc = {
+	.name = "sn2400-battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = sn2400_bat_props,
+	.num_properties = ARRAY_SIZE(sn2400_bat_props),
+	.get_property = sn2400_bat_get,
+};
+
+static void sn2400_stop_poll(void *data)
+{
+	struct sn2400 *c = data;
+
+	cancel_delayed_work_sync(&c->poll);
+}
+
+static int sn2400_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct power_supply_config cfg = {};
+	struct sn2400 *c;
+	int status, ret;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->client = client;
+	mutex_init(&c->lock);
+
+	/* o chip não tem registrador de ID: conferimos que ele responde */
+	status = sn2400_read(c, SN2400_STATUS);
+	if (status < 0)
+		return dev_err_probe(dev, status, "chip não responde no I2C\n");
+	c->online = status & SN2400_STATUS_VBUS;
+
+	c->ilim_ua = 450000;		/* o mesmo que o iBoot programa */
+	device_property_read_u32(dev, "input-current-limit-microamp",
+				 &c->ilim_ua);
+
+	cfg.drv_data = c;
+	cfg.fwnode = dev_fwnode(dev);
+	c->usb = devm_power_supply_register(dev, &sn2400_usb_desc, &cfg);
+	if (IS_ERR(c->usb))
+		return dev_err_probe(dev, PTR_ERR(c->usb), "fonte usb\n");
+	cfg.fwnode = NULL;
+	c->bat = devm_power_supply_register(dev, &sn2400_bat_desc, &cfg);
+	if (IS_ERR(c->bat))
+		return dev_err_probe(dev, PTR_ERR(c->bat), "fonte battery\n");
+
+	INIT_DELAYED_WORK(&c->poll, sn2400_poll);
+	ret = devm_add_action_or_reset(dev, sn2400_stop_poll, c);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&c->poll, 0);
+
+	dev_info(dev, "SN2400: cabo %s, limite de entrada desejado %u mA\n",
+		 c->online ? "conectado" : "desconectado", c->ilim_ua / 1000);
+	return 0;
+}
+
+static const struct of_device_id sn2400_of_match[] = {
+	{ .compatible = "ti,sn2400" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sn2400_of_match);
+
+static const struct i2c_device_id sn2400_id[] = {
+	{ "sn2400" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sn2400_id);
+
+static struct i2c_driver sn2400_driver = {
+	.driver = {
+		.name = "sn2400-charger",
+		.of_match_table = sn2400_of_match,
+	},
+	.probe = sn2400_probe,
+	.id_table = sn2400_id,
+};
+module_i2c_driver(sn2400_driver);
+
+MODULE_DESCRIPTION("TI SN2400 (Apple 'Tigris') charger");
+MODULE_LICENSE("GPL");
