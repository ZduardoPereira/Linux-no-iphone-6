input: driver novo do touchscreen do iPhone 6 (chip N1, SPI) + device tree (fase 5, T5)

diff --git b/drivers/input/touchscreen/apple_n1.c b/drivers/input/touchscreen/apple_n1.c
new file mode 100644
index 0000000..4f9e010
--- /dev/null
+++ b/drivers/input/touchscreen/apple_n1.c
@@ -0,0 +1,466 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Touchscreen do iPhone 6: chip "N1" (família Apple Z2) no SPI2.
+ *
+ * Projeto Linux-no-iphone-6, fase 5 (T5). Feito a partir do nosso protótipo em
+ * Python (device/n1.py), que leu os primeiros toques. O protocolo veio da engenharia
+ * reversa do driver do iOS 12.5.5 feita por github.com/ITSMEFRTRUST/linux-on-iphone6
+ * (re/MULTITOUCH.md) e foi conferido passo a passo no aparelho.
+ *
+ * Sequência no probe (a mesma do iOS):
+ *   1. alimentação analógica: PMU da tela "Chestnut" (i2c0 0x27), reg 0x05 |= 0x17
+ *      (o LDO15 do PMIC principal, a outra alimentação, já vem ligado)
+ *   2. clock de 32,768 kHz: PMGR TOUCH_CTL (gate b31, enable b19, busy b18, div 0x2dc)
+ *   3. pedido de despertar (19 c1), soltar o reset, sondar o bootloader
+ *   4. calibração de fábrica (vem do ADT pelo m1n1: apple,z2-[prox-]cal-blob)
+ *   5. firmware (request_firmware; extraído do iOS por scripts/09-firmware-touch.sh)
+ *   6. escritas de configuração, "calibrar", EXECUTE em 0x10003400
+ * Depois, a cada interrupção (GPIO 3, nível baixo) lê-se um relatório: o 0x44 traz
+ * os dedos (registros de 30 bytes, X/Y em 0,01 mm, Y para cima).
+ *
+ * Pendências: o clock e o LDO deveriam ser drivers de clock/regulador próprios; sem
+ * suspend/resume; o SPI fica em 4 MHz (o iOS usa ~12 MHz).
+ */
+
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/property.h>
+#include <linux/spi/spi.h>
+#include <linux/unaligned.h>
+
+#define N1_ACK_DATA		0x4bc1
+#define N1_ACK_ESCRITA		0x4ad1
+#define N1_END_PROX		0x10009600
+#define N1_END_CAL		0x10009000
+#define N1_PEDACO_CAL		0x3f0
+#define N1_END_EXECUTE		0x10003400
+#define N1_MAX_FRAME		4096
+
+#define N1_RELATORIO_DEDOS	0x44
+#define N1_X_MAX		5850		/* 58,50 mm */
+#define N1_Y_MAX		10405		/* 104,05 mm */
+#define N1_SLOTS		16
+
+#define CHESTNUT_LDO		0x05
+#define CHESTNUT_LDO_TOUCH	0x17		/* LDO2 (0x10) + bits compartilhados */
+
+#define TOUCH_CTL_GATE		BIT(31)
+#define TOUCH_CTL_EN		BIT(19)
+#define TOUCH_CTL_BUSY		BIT(18)
+#define TOUCH_CTL_DIV		0x2dc		/* 24 MHz / 732 = 32,768 kHz */
+
+struct apple_n1 {
+	struct spi_device *spi;
+	struct input_dev *input;
+	struct gpio_desc *reset;
+	struct i2c_client *chestnut;
+	void __iomem *clk_reg;
+	struct touchscreen_properties props;
+	u8 *tx, *rx;				/* buffers dos relatórios */
+	u8 ctr;
+};
+
+/* ---------- SPI ---------- */
+
+static int n1_xfer(struct apple_n1 *n1, const void *tx, void *rx, size_t len)
+{
+	struct spi_transfer t = { .tx_buf = tx, .rx_buf = rx, .len = len };
+
+	return spi_sync_transfer(n1->spi, &t, 1);
+}
+
+/* para pacotes curtos: copia para buffers próprios e devolve o rx */
+static int n1_cmd(struct apple_n1 *n1, const u8 *cmd, size_t len, u8 *rx)
+{
+	memcpy(n1->tx, cmd, len);
+	return n1_xfer(n1, n1->tx, rx ? rx : n1->rx, len);
+}
+
+/* sw32(v) = bytes v[15:8] v[7:0] v[31:24] v[23:16] */
+static void sw32(u8 *p, u32 v)
+{
+	p[0] = v >> 8; p[1] = v; p[2] = v >> 24; p[3] = v >> 16;
+}
+
+static u16 soma(const u8 *p, size_t n)
+{
+	u32 s = 0;
+
+	while (n--)
+		s += *p++;
+	return s;
+}
+
+static int n1_atn_ack(struct apple_n1 *n1)
+{
+	static const u8 ack[] = { 0x1a, 0xa1 };
+	u8 rx[2];
+	int ret = n1_cmd(n1, ack, sizeof(ack), rx);
+
+	return ret ?: get_unaligned_be16(rx);
+}
+
+/* Pacote DATA: 18 e1 30 01 | palavras(BE16) sw32(end) ck16 | dados em pares trocados | sw32(soma) */
+static int n1_envia_data(struct apple_n1 *n1, u32 end, const u8 *dados, size_t len,
+			 const char *nome)
+{
+	size_t l4 = ALIGN(len, 4), i;
+	u32 s = 0;
+	u8 *p;
+	int ret = -EIO, t;
+
+	p = kzalloc(12 + l4 + 4, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p[0] = 0x18; p[1] = 0xe1; p[2] = 0x30; p[3] = 0x01;
+	put_unaligned_be16(l4 / 4, p + 4);
+	sw32(p + 6, end);
+	put_unaligned_be16(soma(p + 4, 6), p + 10);
+	for (i = 0; i < len; i++) {
+		p[12 + (i ^ 1)] = dados[i];
+		s += dados[i];
+	}
+	sw32(p + 12 + l4, s);
+
+	for (t = 0; t < 5; t++) {
+		ret = n1_xfer(n1, p, NULL, 12 + l4 + 4);
+		if (!ret && n1_atn_ack(n1) == N1_ACK_DATA)
+			break;
+		ret = -EIO;
+	}
+	kfree(p);
+	if (ret)
+		dev_err(&n1->spi->dev, "%s não foi aceito pelo chip\n", nome);
+	return ret;
+}
+
+static int n1_mem_escreve(struct apple_n1 *n1, u32 end, u32 val)
+{
+	u8 c[16] = { 0x1e, 0x33 };
+	int a;
+
+	sw32(c + 2, end);
+	sw32(c + 6, 0xffffffff);		/* máscara */
+	sw32(c + 10, val);
+	put_unaligned_be16(soma(c + 2, 12), c + 14);
+	n1_cmd(n1, c, sizeof(c), NULL);
+	a = n1_atn_ack(n1);
+	if (a != N1_ACK_ESCRITA) {
+		dev_err(&n1->spi->dev, "escrita em %#x recusada (%#x)\n", end, a);
+		return -EIO;
+	}
+	return 0;
+}
+
+static u32 n1_mem_le(struct apple_n1 *n1, u32 end)
+{
+	static const u8 longo[] = { 0x1a, 0xa1, 0x18, 0xe1, 0x18, 0xe1, 0x18, 0xe1 };
+	u8 c[8] = { 0x1c, 0x73 }, rx[8];
+
+	sw32(c + 2, end);
+	put_unaligned_be16(soma(c + 2, 4), c + 6);
+	n1_cmd(n1, c, sizeof(c), NULL);
+	n1_cmd(n1, longo, sizeof(longo), rx);
+	return get_unaligned_be16(rx + 2) | get_unaligned_be16(rx + 4) << 16;
+}
+
+/* ---------- ligar e dar a partida ---------- */
+
+static int n1_liga(struct apple_n1 *n1)
+{
+	static const u8 acorda[] = { 0x19, 0xc1 };
+	static const u8 sonda[16] = { 0x1a, 0xa1, 0x18, 0xe1, 0x18, 0xe1, 0x18, 0xe1,
+				      0x18, 0xe1, 0x18, 0xe1, 0x18, 0xe1, 0x18, 0xe1 };
+	u32 v;
+	int ldo, ret, r;
+
+	ldo = i2c_smbus_read_byte_data(n1->chestnut, CHESTNUT_LDO);
+	if (ldo < 0)
+		return ldo;
+	ret = i2c_smbus_write_byte_data(n1->chestnut, CHESTNUT_LDO, ldo | CHESTNUT_LDO_TOUCH);
+	if (ret)
+		return ret;
+	usleep_range(5000, 6000);
+
+	v = readl(n1->clk_reg);
+	writel(v & ~TOUCH_CTL_GATE, n1->clk_reg);
+	udelay(8);
+	writel((v & ~TOUCH_CTL_GATE & ~0x3ff) | TOUCH_CTL_EN | TOUCH_CTL_DIV, n1->clk_reg);
+	ret = readl_poll_timeout(n1->clk_reg, v, !(v & TOUCH_CTL_BUSY), 10, 10000);
+	if (ret)
+		return ret;
+	msleep(15);
+
+	n1_cmd(n1, acorda, sizeof(acorda), NULL);
+	msleep(10);
+	n1_cmd(n1, sonda, sizeof(sonda), NULL);		/* "garantir S_CLK alto" */
+	gpiod_set_value_cansleep(n1->reset, 0);		/* solta o reset */
+	msleep(30);
+
+	n1_cmd(n1, sonda, sizeof(sonda), NULL);
+	r = get_unaligned_be16(n1->rx);
+	switch (r) {
+	case 0x18e1: case 0x1aa1: case 0x1f01: case 0x4879:
+	case 0x4969: case 0x4ad1: case 0x4bc1:
+		dev_info(&n1->spi->dev, "bootloader respondeu %04x\n", r);
+		return 0;
+	}
+	dev_err(&n1->spi->dev, "bootloader não respondeu (%*ph)\n", 4, n1->rx);
+	return -ENODEV;
+}
+
+static int n1_partida(struct apple_n1 *n1)
+{
+	struct device *dev = &n1->spi->dev;
+	static const u8 calibra[] = { 0x1f, 0x01 };
+	const struct firmware *fw;
+	const u8 *cal, *prox;
+	int cal_len, prox_len, ret, off;
+	u8 exec[12] = { 0x1d, 0x53 };
+	u32 versao;
+
+	prox_len = device_property_count_u8(dev, "apple,z2-prox-cal-blob");
+	cal_len = device_property_count_u8(dev, "apple,z2-cal-blob");
+	prox = of_get_property(dev->of_node, "apple,z2-prox-cal-blob", NULL);
+	cal = of_get_property(dev->of_node, "apple,z2-cal-blob", NULL);
+	if (prox_len > 0 && prox) {
+		ret = n1_envia_data(n1, N1_END_PROX, prox, prox_len, "PxCl");
+		if (ret)
+			return ret;
+	}
+	if (cal_len > 0 && cal) {
+		for (off = 0; off < cal_len; off += N1_PEDACO_CAL) {
+			ret = n1_envia_data(n1, N1_END_CAL + off, cal + off,
+					    min(cal_len - off, N1_PEDACO_CAL), "MtCl");
+			if (ret)
+				return ret;
+		}
+	} else {
+		dev_warn(dev, "sem calibração no device tree (m1n1 com o patch 0004?)\n");
+	}
+
+	ret = request_firmware(&fw, "apple/n61-touch.bin", dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "falta /lib/firmware/apple/n61-touch.bin\n");
+	ret = n1_xfer(n1, fw->data, NULL, fw->size);	/* já é um pacote DATA pronto */
+	if (!ret && n1_atn_ack(n1) != N1_ACK_DATA)
+		ret = -EIO;
+	release_firmware(fw);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware não aceito\n");
+
+	versao = n1_mem_le(n1, 0x10008ffc);
+	ret = n1_mem_escreve(n1, 0x10003060, 0x17d3) ?:
+	      n1_mem_escreve(n1, 0x1000305c, 0x2) ?:
+	      n1_mem_escreve(n1, 0x10003058, 0x6) ?:
+	      n1_mem_escreve(n1, 0x10003000, versao == 0x434d11a0 ? 2 : 3) ?:
+	      n1_mem_escreve(n1, 0x10003518, 1);
+	if (ret)
+		return ret;
+	n1_mem_le(n1, 0x10003800);
+	n1_cmd(n1, calibra, sizeof(calibra), NULL);
+	msleep(65);
+	n1_atn_ack(n1);
+
+	sw32(exec + 2, N1_END_EXECUTE);
+	sw32(exec + 6, 1);
+	put_unaligned_be16(soma(exec + 2, 8), exec + 10);
+	n1_cmd(n1, exec, sizeof(exec), NULL);
+	msleep(40);
+	dev_info(dev, "firmware rodando (versão %#010x)\n", versao);
+	return 0;
+}
+
+/* ---------- leitura dos toques ---------- */
+
+/* comando 0xEB: pergunta o tamanho e lê o relatório; devolve o tamanho da carga */
+static int n1_le_frame(struct apple_n1 *n1, u8 **carga)
+{
+	u8 *tx = n1->tx, *rx = n1->rx;
+	int n, L;
+
+	memset(tx, 0, 16);
+	tx[0] = 0xeb;
+	tx[1] = n1->ctr;
+	put_unaligned_le16(soma(tx, 14), tx + 14);
+	if (n1_xfer(n1, tx, rx, 16))
+		return -EIO;
+	if ((rx[0] & 0xf0) != 0xe0 || get_unaligned_le16(rx + 14) != soma(rx, 14))
+		return -EIO;
+	n = get_unaligned_le16(rx + 1);
+	if (!n)
+		return 0;
+	if (n + 5 > N1_MAX_FRAME)
+		return -E2BIG;
+
+	memset(tx, 0, n + 5);
+	tx[0] = 0xeb;
+	tx[1] = n1->ctr;
+	tx[2] = 1;
+	put_unaligned_le16(soma(tx, n + 3), tx + n + 3);
+	if (n1_xfer(n1, tx, rx, n + 5))
+		return -EIO;
+	if ((rx[0] != 0xeb && rx[0] != 0xea) || (soma(rx, 5) & 0xff))
+		return -EIO;
+	L = get_unaligned_le16(rx + 2);
+	if (L < 2 || L + 5 > n + 5 ||
+	    get_unaligned_le16(rx + 5 + L - 2) != soma(rx + 5, L - 2))
+		return -EIO;
+	n1->ctr = 3 - n1->ctr;			/* alterna 1 <-> 2 após frame bom */
+	*carga = rx + 5;
+	return L - 2;
+}
+
+static void n1_relata(struct apple_n1 *n1, const u8 *p, int len)
+{
+	int n, tam, ini, i;
+
+	if (len < 24 || p[0] != N1_RELATORIO_DEDOS)
+		return;
+	n = p[16];
+	tam = p[17];
+	ini = p[2] + get_unaligned_le16(p + 14);
+	if (tam < 30 || ini + n * tam > len)
+		return;
+
+	for (i = 0; i < n; i++) {
+		const u8 *r = p + ini + i * tam;
+		int slot = r[0] % N1_SLOTS;
+		bool tocando = r[1] == 3 || r[1] == 4;	/* encostou / tocando */
+		int x = clamp_t(int, (s16)get_unaligned_le16(r + 4), 0, N1_X_MAX);
+		int y = clamp_t(int, (s16)get_unaligned_le16(r + 6), 0, N1_Y_MAX);
+
+		input_mt_slot(n1->input, slot);
+		if (!input_mt_report_slot_state(n1->input, MT_TOOL_FINGER, tocando))
+			continue;
+		/* o chip mede Y de baixo para cima; a tela, de cima para baixo */
+		touchscreen_report_pos(n1->input, &n1->props, x, N1_Y_MAX - y, true);
+		input_report_abs(n1->input, ABS_MT_TOUCH_MAJOR, get_unaligned_le16(r + 12));
+		input_report_abs(n1->input, ABS_MT_TOUCH_MINOR, get_unaligned_le16(r + 14));
+	}
+	input_mt_sync_frame(n1->input);
+	input_sync(n1->input);
+}
+
+static irqreturn_t n1_irq(int irq, void *data)
+{
+	struct apple_n1 *n1 = data;
+	u8 *carga;
+	int len = n1_le_frame(n1, &carga);
+
+	if (len > 0)
+		n1_relata(n1, carga, len);
+	return IRQ_HANDLED;
+}
+
+/* ---------- probe ---------- */
+
+static void n1_solta_chestnut(void *data)
+{
+	put_device(data);
+}
+
+static int apple_n1_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct device_node *np;
+	struct apple_n1 *n1;
+	u64 clk;
+	int ret;
+
+	n1 = devm_kzalloc(dev, sizeof(*n1), GFP_KERNEL);
+	if (!n1)
+		return -ENOMEM;
+	n1->spi = spi;
+	n1->ctr = 1;
+	n1->tx = devm_kzalloc(dev, N1_MAX_FRAME, GFP_KERNEL);
+	n1->rx = devm_kzalloc(dev, N1_MAX_FRAME, GFP_KERNEL);
+	if (!n1->tx || !n1->rx)
+		return -ENOMEM;
+
+	n1->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);	/* em reset */
+	if (IS_ERR(n1->reset))
+		return dev_err_probe(dev, PTR_ERR(n1->reset), "reset-gpios\n");
+
+	np = of_parse_phandle(dev->of_node, "apple,display-pmu", 0);
+	if (!np)
+		return dev_err_probe(dev, -EINVAL, "falta apple,display-pmu\n");
+	n1->chestnut = of_find_i2c_device_by_node(np);
+	of_node_put(np);
+	if (!n1->chestnut)
+		return -EPROBE_DEFER;
+	ret = devm_add_action_or_reset(dev, n1_solta_chestnut, &n1->chestnut->dev);
+	if (ret)
+		return ret;
+
+	if (device_property_read_u64(dev, "apple,touch-clock-reg", &clk))
+		return dev_err_probe(dev, -EINVAL, "falta apple,touch-clock-reg\n");
+	n1->clk_reg = devm_ioremap(dev, clk, 4);
+	if (!n1->clk_reg)
+		return -ENOMEM;
+
+	ret = n1_liga(n1);
+	if (ret)
+		return ret;
+	ret = n1_partida(n1);
+	if (ret)
+		return ret;
+
+	n1->input = devm_input_allocate_device(dev);
+	if (!n1->input)
+		return -ENOMEM;
+	n1->input->name = "Apple iPhone 6 touchscreen";
+	n1->input->id.bustype = BUS_SPI;
+	input_set_abs_params(n1->input, ABS_MT_POSITION_X, 0, N1_X_MAX, 0, 0);
+	input_set_abs_params(n1->input, ABS_MT_POSITION_Y, 0, N1_Y_MAX, 0, 0);
+	input_abs_set_res(n1->input, ABS_MT_POSITION_X, 100);	/* unidades por mm */
+	input_abs_set_res(n1->input, ABS_MT_POSITION_Y, 100);
+	input_set_abs_params(n1->input, ABS_MT_TOUCH_MAJOR, 0, 0xffff, 0, 0);
+	input_set_abs_params(n1->input, ABS_MT_TOUCH_MINOR, 0, 0xffff, 0, 0);
+	touchscreen_parse_properties(n1->input, true, &n1->props);
+	ret = input_mt_init_slots(n1->input, N1_SLOTS, INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+	ret = input_register_device(n1->input);
+	if (ret)
+		return ret;
+
+	return devm_request_threaded_irq(dev, spi->irq, NULL, n1_irq, IRQF_ONESHOT,
+					 "apple-n1", n1);
+}
+
+static const struct of_device_id apple_n1_of_match[] = {
+	{ .compatible = "apple,n61-touchscreen" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apple_n1_of_match);
+
+static const struct spi_device_id apple_n1_spi_id[] = {
+	{ "n61-touchscreen" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, apple_n1_spi_id);
+
+static struct spi_driver apple_n1_driver = {
+	.driver = {
+		.name = "apple-n1",
+		.of_match_table = apple_n1_of_match,
+	},
+	.id_table = apple_n1_spi_id,
+	.probe = apple_n1_probe,
+};
+module_spi_driver(apple_n1_driver);
+
+MODULE_DESCRIPTION("iPhone 6 (N1) touchscreen");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE("apple/n61-touch.bin");
diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 9b9ae8a..ce4ec4a 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -103,6 +103,15 @@ config TOUCHSCREEN_ADC
 	  To compile this driver as a module, choose M here: the
 	  module will be called resistive-adc-touch.ko.
 
+config TOUCHSCREEN_APPLE_N1
+	tristate "Apple N1 touchscreen (iPhone 6)"
+	depends on SPI && I2C && (ARCH_APPLE || COMPILE_TEST)
+	select INPUT_MT
+	help
+	  Touchscreen of the iPhone 6 (Apple N1, Z2 family, on SPI). Needs the
+	  touch firmware extracted from iOS in /lib/firmware/apple/n61-touch.bin
+	  (Linux-no-iphone-6).
+
 config TOUCHSCREEN_APPLE_Z2
 	tristate "Apple Z2 touchscreens"
 	depends on SPI && (ARCH_APPLE || COMPILE_TEST)
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index bfd9de8..86986cb 100644
