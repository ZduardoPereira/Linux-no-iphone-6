block: apple-ans1: armazenamento interno do A7/A8 (ANS) + DTS do iPhone 6

Disco de blocos sobre o coprocessador ANS (RTKit v10, endpoint 6), com o
firmware que o iBoot deixou na RAM (descrito pelo m1n1 via alias 'asp').
Protocolo do m1n1/HoolockLinux (src/ans1.c, proxyclient fw/ans1.py).
Só leitura por padrão (parâmetro escrita=1 libera).

Os buffers que o ANS lê e escreve (comandos e intermediário) são mapeados como
memória Device: o memcache do A8 guarda cópias dos acessos Normal da CPU (com ou
sem cache) e não vê as escritas do ANS; acessos Device passam por fora dele.

diff --git b/drivers/block/apple-ans1.c b/drivers/block/apple-ans1.c
new file mode 100644
index 0000000..9375862
--- /dev/null
+++ b/drivers/block/apple-ans1.c
@@ -0,0 +1,1145 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Armazenamento interno dos Apple A7/A8 ("ANS1"/ASP) como disco de blocos.
+ * Linux-no-iphone-6.
+ *
+ * A flash não é NVMe nesses chips: quem cuida dela é o ANS, um coprocessador
+ * ARM com firmware próprio (carregado pelo iBoot na RAM, "pre-loaded"). O Linux
+ * conversa com ele pelo RTKit, através do mailbox AKF:
+ *
+ *   1. aponta o ANS para o firmware na RAM (registradores REMAP) e dá a partida;
+ *   2. RTKit: HELLO, mapa de endpoints, liga o endpoint do armazenamento (6 na v10);
+ *   3. o ANS avisa "pronto" (tag 254); entregamos o buffer de comandos (tag 253);
+ *   4. cada comando de 0x30 bytes + lista de páginas de 4 KB vai no buffer; a
+ *      "campainha" (SQ_DB) avisa o ANS, que responde COMPLETE com tag e status.
+ *
+ * Protocolo descoberto pela HoolockLinux: m1n1 src/ans1.c e
+ * proxyclient/m1n1/fw/ans1.py (licença MIT).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/blk-mq.h>
+#include <linux/blkdev.h>
+#include <linux/delay.h>
+#include <linux/ctype.h>
+#include <linux/unaligned.h>
+#include <linux/firmware.h>
+#include <linux/ktime.h>
+#include <linux/dma-mapping.h>
+#include <linux/highmem.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/vmalloc.h>
+
+/* registradores do IOP (AKF), a partir do reg 0 */
+#define AKF_REMAP_PHYS_LO	0x08
+#define AKF_REMAP_PHYS_HI	0x0c
+#define AKF_REMAP_IOVA_LO	0x10
+#define AKF_REMAP_IOVA_HI	0x14
+#define AKF_REMAP_SIZE_LO	0x18
+#define AKF_REMAP_SIZE_HI	0x1c
+#define AKF_ENDIANNESS		0x20	/* 1 = little endian */
+#define AKF_CPU_CONTROL		0x28
+#define AKF_CPU_CONTROL_START	BIT(4)
+#define AKF_UNK_80C		0x80c
+
+/* mensagens no endpoint do armazenamento */
+#define ANS1_MSG_TYPE		GENMASK_ULL(3, 0)
+#define ANS1_MSG_SET_CMDBUF	0
+#define ANS1_MSG_SET_TAG	1
+#define ANS1_MSG_COMPLETE	2
+#define ANS1_MSG_SQ_DB		3
+#define ANS1_MSG_UNK4		4
+#define ANS1_CMDBUF_BASE	GENMASK_ULL(55, 16)
+#define ANS1_CMDBUF_SIZE_17_6	GENMASK_ULL(15, 4)
+#define ANS1_TAG_SIZE_17_6	GENMASK_ULL(35, 24)
+#define ANS1_TAG_OFF_17_6	GENMASK_ULL(23, 12)
+#define ANS1_TAG_TAG		GENMASK_ULL(7, 4)
+#define ANS1_SQ_DB_OP		GENMASK_ULL(19, 12)
+#define ANS1_SQ_DB_OP_RING	0xff
+#define ANS1_SQ_DB_TAG		GENMASK_ULL(7, 4)
+#define ANS1_DONE_STATUS	GENMASK_ULL(15, 12)
+#define ANS1_DONE_TAG		GENMASK_ULL(11, 4)
+#define ANS1_STATUS_OK		0
+#define ANS1_STATUS_INIT	0xa	/* resposta das tags especiais */
+#define ANS1_TAG_READY		254	/* o ANS manda sozinho depois de ligar o endpoint */
+#define ANS1_TAG_CMDBUF_READY	253	/* resposta do SET_CMDBUF */
+
+/* comandos */
+#define ANS1_OP_IDENTIFY	0x00
+#define ANS1_OP_READ		0x10	/* "UserArea" = o disco principal */
+#define ANS1_OP_WRITE		0x11
+#define ANS1_OP_WRITE_UNLOCK	0x19
+/*
+ * 0x1b = abre o armazenamento para E/S (achado no iBoot 4513.270.14: antes da
+ * primeira leitura/escrita, o driver ASP dele refaz os buffers, manda a
+ * configuração de energia e este comando). Com o firmware limpo, sem ele a
+ * primeira leitura derruba o ANS ("L2V_Search.c:78 assert failed").
+ */
+#define ANS1_OP_ABRE_IO		0x1b
+/*
+ * 0x14 = desligamento FINAL / grava o contexto (achado no firmware ANS1-710.260.6:
+ * o analisador de comandos traduz o opcode 0x14 para o tipo interno 0x17, cujo
+ * tratamento chama a mesma rotina de desligamento que Cmd_HandleNvmeShutdown, a
+ * que contém "Bad shutdown"). Sem isso o firmware abandona as áreas abertas no
+ * próximo boot ("Push abandoning non-blank band ... uncleanReboot"). Medido: é como o
+ * shutdown do NVMe; continuar usando o ANS depois dele faz tudo sumir no boot
+ * seguinte. NÃO serve como flush.
+ */
+#define ANS1_OP_SHUTDOWN	0x14
+#define ANS1_OP_INIT_R		0x72	/* o iBoot manda depois do identify */
+#define ANS1_OP_POWER_CONFIG	0x80
+#define ANS1_FLAG_NO_ENCRYPTION	BIT(3)	/* sem isso o AES em linha embaralha os dados */
+
+struct ans1_cmd_hdr {
+	u8 op;
+	u8 tag;
+	__le16 flags;
+	__le32 slba;
+	__le32 length;		/* em páginas de 4 KB */
+	u8 pad[0x24];
+	__le32 pages[];		/* número da página física (endereço >> 12) */
+} __packed;
+static_assert(sizeof(struct ans1_cmd_hdr) == 0x30);
+
+#define ANS1_PAGE		SZ_4K
+#define ANS1_MAX_PAGES		256	/* 1 MB por comando */
+#define ANS1_CMD_SIZE		ALIGN(0x30 + ANS1_MAX_PAGES * 4, 64)
+#define ANS1_MAX_TAGS		16
+#define ANS1_TIMEOUT		(5 * HZ)
+
+static unsigned int ntags = 1;
+module_param(ntags, uint, 0444);
+MODULE_PARM_DESC(ntags, "comandos simultâneos no ANS (1..16)");
+
+/*
+ * Escrita só dentro de uma JANELA de blocos do disco (LBAs de 4 KB, [de, ate)).
+ * Fora dela, erro, mesmo que um programa erre o endereço: o iOS continua na flash
+ * (o iBoot lê dele o kernel, o DeviceTree e o firmware do SEP, e o nosso boot pelo
+ * checkra1n depende disso). A janela deve ficar no espaço livre do APFS
+ * (host/apfs_livre.py). Sem janela, o disco é só leitura.
+ */
+static ulong escrita_de, escrita_ate;
+module_param(escrita_de, ulong, 0444);
+MODULE_PARM_DESC(escrita_de, "primeiro bloco (LBA de 4 KB do disco) onde é permitido escrever");
+module_param(escrita_ate, ulong, 0444);
+MODULE_PARM_DESC(escrita_ate, "fim (exclusivo) da janela de escrita; 0 = só leitura");
+#define escrita (escrita_ate > escrita_de)
+
+/*
+ * O MEMCACHE (cache do lado da memória do A8) E O DMA DO ANS
+ *
+ * O ANS escreve na RAM por fora do memcache, mas a CPU passa por ele em todo acesso
+ * de memória "Normal", com ou sem cache: o memcache guarda cópias do que a CPU lê
+ * e descarrega, e depois a CPU lê essas cópias velhas em vez do que o ANS escreveu
+ * (e uma cópia suja pode até voltar para a RAM por cima dos dados). A manutenção
+ * de cache do ARM não alcança o memcache. Medido no iPhone 6:
+ *   - buffer recém-escrito pela CPU: 0/40 leituras certas; depois de varrer 8 MB
+ *     (expulsa o memcache): 40/40;
+ *   - resposta do identify (escrita pelo ANS no buffer de comandos) chegava pela
+ *     metade: só a linha que a CPU tinha lido antes vinha velha.
+ * Acessos de memória "Device" não passam pelo memcache. Então o ANS só lê e
+ * escreve em buffers mapeados como Device (comandos + intermediário), varridos uma
+ * vez na carga, e o driver copia entre eles e as páginas do Linux.
+ * (Muito provavelmente é também o motivo de o DMA do USB nunca ter funcionado.)
+ */
+#define ANS1_VARRE		(8 << 20)	/* > memcache (4 MB) */
+
+struct ans1_buf {
+	struct page *pg;
+	unsigned int ordem;
+	void *v;			/* mapeamento Device */
+	dma_addr_t fis;
+};
+
+/* páginas contíguas mapeadas como Device (nGnRnE): fora do memcache */
+static int ans1_buf_aloca(struct ans1_buf *b, size_t tam)
+{
+	unsigned int n = PAGE_ALIGN(tam) >> PAGE_SHIFT, i;
+	struct page **v;
+
+	b->ordem = get_order(tam);
+	b->pg = alloc_pages(GFP_KERNEL, b->ordem);
+	if (!b->pg)
+		return -ENOMEM;
+	v = kcalloc(n, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		goto erro;
+	for (i = 0; i < n; i++)
+		v[i] = b->pg + i;
+	b->v = vmap(v, n, VM_MAP, pgprot_noncached(PAGE_KERNEL));
+	kfree(v);
+	if (!b->v)
+		goto erro;
+	memset_io((void __iomem *)b->v, 0, tam);
+	b->fis = page_to_phys(b->pg);
+	return 0;
+erro:
+	__free_pages(b->pg, b->ordem);
+	b->pg = NULL;
+	return -ENOMEM;
+}
+
+static void ans1_buf_libera(void *arg)
+{
+	struct ans1_buf *b = arg;
+
+	if (b->v)
+		vunmap(b->v);
+	if (b->pg)
+		__free_pages(b->pg, b->ordem);
+}
+
+/* expulsa do memcache cópias antigas das páginas recém-alocadas (uma vez, na carga) */
+static void ans1_varre(void)
+{
+	u8 *v = vmalloc(ANS1_VARRE);
+
+	for (size_t i = 0; v && i < ANS1_VARRE; i += 64)
+		WRITE_ONCE(v[i], READ_ONCE(v[i]) + 1);
+	vfree(v);
+}
+
+/*
+ * Cópia rápida de memória Device (alinhada a 64 bytes): 4 ldp por iteração. O
+ * memcpy_fromio lê de 8 em 8 bytes e deixava a leitura em ~34 MB/s (assim, ~71).
+ */
+static void ans1_copia_dev(void *dst, const void *src, size_t n)
+{
+	const u64 *s64 = src;
+	u64 *d64 = dst;
+
+	if (((unsigned long)src | (unsigned long)dst | n) & 63) {
+		memcpy_fromio(dst, (const void __iomem *)src, n);
+		return;
+	}
+	for (; n; n -= 64, s64 += 8, d64 += 8) {
+		u64 a, b, c, d, e, f, g, h;
+
+		asm volatile("ldp %0, %1, [%8]\n\t"
+			     "ldp %2, %3, [%8, #16]\n\t"
+			     "ldp %4, %5, [%8, #32]\n\t"
+			     "ldp %6, %7, [%8, #48]"
+			     : "=&r"(a), "=&r"(b), "=&r"(c), "=&r"(d),
+			       "=&r"(e), "=&r"(f), "=&r"(g), "=&r"(h)
+			     : "r"(s64) : "memory");
+		d64[0] = a; d64[1] = b; d64[2] = c; d64[3] = d;
+		d64[4] = e; d64[5] = f; d64[6] = g; d64[7] = h;
+	}
+}
+
+/*
+ * Firmware LIMPO do ANS (extraído do iBoot do iOS 12.5.7 por scripts/11-firmware-ans.sh).
+ * A cópia que o iBoot deixa na RAM já foi usada (o __DATA mudou e terminou num
+ * "dormir"); dar a partida nela faz o firmware entrar em recuperação a cada sessão
+ * (Push_AbortSkip) e, se a sessão termina sem o "dormir", o boot seguinte descarta
+ * o log de contexto e volta no tempo. Antes de cada partida a frio, recarregamos a
+ * imagem original, como o iBoot faz a cada boot.
+ */
+#define ANS1_FW_NOME		"apple/ans1-n61.bin"
+static bool fw_limpo = true;
+module_param(fw_limpo, bool, 0444);
+MODULE_PARM_DESC(fw_limpo, "recarrega o firmware original do ANS antes de cada partida (padrão: sim)");
+
+#define ANS1_DATA		0x4a000	/* início do __DATA na região do firmware */
+#define ANS1_TAB_MAX		0x200
+
+/* tamanho da tabela de parâmetros (etiqueta de 4 letras, tamanho, valor; ...) */
+static size_t ans1_tabela_tam(const u8 *t, size_t max)
+{
+	size_t p = 0;
+
+	while (p + 8 <= max) {
+		u32 n = get_unaligned_le32(t + p + 4);
+
+		for (int i = 0; i < 4; i++)
+			if (!isalnum(t[p + i]) && t[p + i] != '_')
+				return p;
+		if (n > 0x100 || p + 8 + n > max)
+			return p;
+		p += 8 + n;
+	}
+	return p;
+}
+
+/*
+ * Cochilo: sem pedidos por este tempo, o ANS dorme de forma limpa (salva o contexto
+ * do FTL) e a CPU dele para; o próximo pedido religa (~1 s). Medido: a flash só
+ * sobrevive a um corte de energia DE VERDADE (DFU, bateria) se o ANS estava
+ * dormindo; com ele acordado, o boot seguinte volta para um estado bem antigo (o
+ * chip NAND perde o que guardava). No corte simulado (chip com energia) não perde.
+ */
+static unsigned int cochilo_ms = 2000;
+module_param(cochilo_ms, uint, 0644);
+MODULE_PARM_DESC(cochilo_ms, "ms sem uso até o ANS dormir (0 = nunca)");
+
+/*
+ * Flush. Medido: dormir depois de escrever custa ~1,3 s (o firmware salva o contexto
+ * do FTL; o 0x14 de desligamento NVMe custa o mesmo), religar ~0,36 s, e um fsync do
+ * ext4 manda 2-3 flushes entremeados de escritas: dormir em cada um dava ~3 s, e o
+ * sync ainda terminava com o ANS ACORDADO (a última escrita o religa), que é o estado
+ * em que um corte de energia perde dados. Então, por padrão, o flush só encurta o
+ * cochilo: o ANS dorme UMA vez, cochilo_flush_ms depois do último pedido.
+ * Consistência: o dormir salva todas as escritas já concluídas e a fila está parada
+ * nesse momento, então o que sobrevive é sempre um prefixo do que foi escrito.
+ * flush_espera=1 volta ao flush que dorme na hora.
+ */
+static unsigned int cochilo_flush_ms = 100;
+module_param(cochilo_flush_ms, uint, 0644);
+MODULE_PARM_DESC(cochilo_flush_ms, "ms sem uso até dormir depois de um flush");
+static bool flush_espera;
+module_param(flush_espera, bool, 0644);
+MODULE_PARM_DESC(flush_espera, "flush dorme na hora (lento; o padrão adia para o cochilo)");
+
+static bool depura;
+module_param(depura, bool, 0644);
+MODULE_PARM_DESC(depura, "registra cada comando e o começo dos dados lidos");
+
+static bool init_iboot = true;
+module_param(init_iboot, bool, 0444);
+MODULE_PARM_DESC(init_iboot, "manda a configuração de energia que o iBoot manda (A8)");
+
+struct ans1_rq {
+	blk_status_t status;
+};
+
+struct ans1 {
+	struct device *dev;
+	void __iomem *cpu;
+	struct apple_rtkit *rtk;
+	u8 ep;
+
+	struct ans1_buf cmdb;		/* comandos (ANS1_CMD_SIZE por tag), Device */
+	struct ans1_buf bounce;		/* ANS1_MAX_PAGES páginas por tag, Device */
+	/* sem IOMMU: o ANS usa endereços físicos; a lista de páginas tem 32 bits (<< 12) */
+
+	struct completion ready, cmdbuf_ready;
+
+	/* comandos internos (identify, configuração), só antes do disco existir */
+	bool sync_pending;
+	struct completion sync_done;
+	u8 sync_status;
+
+	struct blk_mq_tag_set tagset;
+	struct gendisk *disk;
+	bool morto;			/* o firmware travou: tudo falha até recarregar */
+	struct mutex estado;		/* dormindo / acordar / dormir */
+	bool dormindo;			/* contexto salvo, CPU parada: seguro desligar */
+	bool saindo;
+	bool flush_pendente;		/* houve flush: dormir logo (cochilo_flush_ms) */
+	struct delayed_work cochilo;
+	unsigned int acordou, dormiu;	/* contadores (sysfs não; só para o log) */
+	const u8 *fw;			/* firmware limpo (__TEXT + __DATA inicial), ou NULL */
+	size_t fw_tam;
+	u64 nr_lba;
+	u32 lba_size;
+};
+
+static struct ans1_cmd_hdr *ans1_cmd(struct ans1 *ans, unsigned int tag)
+{
+	return ans->cmdb.v + tag * ANS1_CMD_SIZE;
+}
+
+static int ans1_send(struct ans1 *ans, u64 msg, bool atomic)
+{
+	return apple_rtkit_send_message(ans->rtk, ans->ep, msg, NULL, atomic);
+}
+
+static int ans1_ring(struct ans1 *ans, unsigned int tag, bool atomic)
+{
+	/*
+	 * O comando tem que ESTAR na RAM antes da campainha. dma_wmb() só ordena; com
+	 * ele o ANS às vezes lia o comando anterior (identify zerado, leituras "atrasadas
+	 * em um"). Ler de volta + wmb() (dsb st) esvazia o buffer de escrita.
+	 */
+	READ_ONCE(ans1_cmd(ans, tag)->length);
+	wmb();
+	return ans1_send(ans, FIELD_PREP(ANS1_SQ_DB_OP, ANS1_SQ_DB_OP_RING) |
+			      FIELD_PREP(ANS1_SQ_DB_TAG, tag) |
+			      FIELD_PREP(ANS1_MSG_TYPE, ANS1_MSG_SQ_DB), atomic);
+}
+
+/* ---------- respostas do ANS (chamado pelo RTKit, fora de interrupção) ---------- */
+static void ans1_recv(void *cookie, u8 ep, u64 msg)
+{
+	struct ans1 *ans = cookie;
+	unsigned int type = FIELD_GET(ANS1_MSG_TYPE, msg);
+	unsigned int tag = FIELD_GET(ANS1_DONE_TAG, msg);
+	unsigned int status = FIELD_GET(ANS1_DONE_STATUS, msg);
+	struct request *rq;
+
+	/*
+	 * O RTKit abre o endpoint ainda durante o boot (early_app_endpoints), e o
+	 * "pronto" (tag 254) chega antes de sabermos o número: adota o primeiro.
+	 */
+	if (!ans->ep)
+		ans->ep = ep;
+	if (ep != ans->ep) {
+		dev_warn(ans->dev, "mensagem no endpoint %u: 0x%llx\n", ep, msg);
+		return;
+	}
+	if (type == ANS1_MSG_UNK4)
+		return;
+	if (type != ANS1_MSG_COMPLETE) {
+		dev_warn(ans->dev, "mensagem desconhecida 0x%llx\n", msg);
+		return;
+	}
+
+	if (tag == ANS1_TAG_READY) {
+		complete(&ans->ready);
+		return;
+	}
+	if (tag == ANS1_TAG_CMDBUF_READY) {
+		complete(&ans->cmdbuf_ready);
+		return;
+	}
+	if (ans->sync_pending && tag == 0) {
+		ans->sync_status = status;
+		ans->sync_pending = false;
+		complete(&ans->sync_done);
+		return;
+	}
+	if (!ans->disk || tag >= ntags) {
+		dev_warn(ans->dev, "resposta para tag %u inesperada (0x%llx)\n", tag, msg);
+		return;
+	}
+
+	rq = blk_mq_tag_to_rq(ans->tagset.tags[0], tag);
+	if (!rq) {
+		dev_warn(ans->dev, "tag %u sem pedido\n", tag);
+		return;
+	}
+	if (depura)
+		dev_info(ans->dev, "resposta 0x%llx (tag %u status %u)\n", msg, tag, status);
+	if (status != ANS1_STATUS_OK)
+		dev_err_ratelimited(ans->dev, "%s no setor %llu falhou: status %u\n",
+				    rq_data_dir(rq) ? "escrita" : "leitura",
+				    blk_rq_pos(rq) >> 3, status);
+	((struct ans1_rq *)blk_mq_rq_to_pdu(rq))->status =
+		status == ANS1_STATUS_OK ? BLK_STS_OK : BLK_STS_IOERR;
+	blk_mq_complete_request(rq);
+}
+
+static void ans1_crashed(void *cookie, const void *crashlog, size_t size)
+{
+	struct ans1 *ans = cookie;
+
+	WRITE_ONCE(ans->morto, true);
+	dev_err(ans->dev, "o firmware do ANS travou (crashlog de %zu bytes); "
+		"os pedidos vão falhar até recarregar o driver\n", size);
+}
+
+static const struct apple_rtkit_ops ans1_rtkit_ops = {
+	.early_app_endpoints = true,	/* senão o ANS não termina de ligar */
+	.crashed = ans1_crashed,
+	.recv_message = ans1_recv,
+};
+
+/* ---------- comandos internos, síncronos (tag 0, antes do add_disk) ---------- */
+struct ans1_campo {
+	u16 off;
+	u32 val;
+};
+
+static int ans1_sync(struct ans1 *ans, u8 op, u16 flags,
+		     const struct ans1_campo *campos, int n)
+{
+	struct ans1_cmd_hdr *cmd = ans1_cmd(ans, 0);
+	int ret, i;
+
+	memset_io((void __iomem *)cmd, 0, ANS1_CMD_SIZE);
+	cmd->op = op;
+	cmd->flags = cpu_to_le16(flags);
+	for (i = 0; i < n; i++)
+		*(__le32 *)((u8 *)cmd + campos[i].off) = cpu_to_le32(campos[i].val);
+
+	reinit_completion(&ans->sync_done);
+	ans->sync_pending = true;
+	ret = ans1_ring(ans, 0, false);
+	if (ret)
+		return ret;
+	if (!wait_for_completion_timeout(&ans->sync_done, ANS1_TIMEOUT)) {
+		ans->sync_pending = false;
+		dev_err(ans->dev, "comando 0x%02x sem resposta\n", op);
+		return -ETIMEDOUT;
+	}
+	if (ans->sync_status != ANS1_STATUS_OK) {
+		dev_warn(ans->dev, "comando 0x%02x: status %u\n", op, ans->sync_status);
+		return -EIO;
+	}
+	dma_rmb();
+	return 0;
+}
+
+/* o que o iBoot manda depois do identify nos chips depois do A7 (ans1.py: cmd_init) */
+static void ans1_init_iboot(struct ans1 *ans)
+{
+	static const struct ans1_campo p1[] = {
+		{ 0x38, 0x2a }, { 0x44, 0x400000 }, { 0x48, 0x400000 } };
+	static const struct ans1_campo p2[] = {
+		{ 0x38, 0x13 }, { 0x3c, 0x3 }, { 0x44, 0x2 }, { 0x48, 0x2 }, { 0x4c, 0x4 },
+		{ 0x50, 0x2 }, { 0x54, 0x4 }, { 0x58, 0x4 }, { 0x5c, 0x2 }, { 0x60, 0x2 } };
+	static const struct ans1_campo p3[] = {
+		{ 0x38, 0x25 }, { 0x3c, 0x3 }, { 0x44, 0x1 }, { 0x48, 0x1 }, { 0x4c, 0x1 },
+		{ 0x50, 0x1 }, { 0x54, 0x1 }, { 0x58, 0x1 }, { 0x5c, 0x1 }, { 0x60, 0x1 } };
+	static const struct ans1_campo alta[] = { { 0x38, 0x26 }, { 0x44, 0x1 } };
+
+	ans1_sync(ans, ANS1_OP_INIT_R, 0, NULL, 0);
+	ans1_sync(ans, ANS1_OP_POWER_CONFIG, 0, p1, ARRAY_SIZE(p1));
+	ans1_sync(ans, ANS1_OP_POWER_CONFIG, 0, p2, ARRAY_SIZE(p2));
+	ans1_sync(ans, ANS1_OP_POWER_CONFIG, 0, p3, ARRAY_SIZE(p3));
+	ans1_sync(ans, ANS1_OP_POWER_CONFIG, 0, alta, ARRAY_SIZE(alta)); /* "alta potência" */
+}
+
+/* ---------- caminho de E/S (blk-mq) ---------- */
+
+static int ans1_boot(struct ans1 *ans, bool silencioso);
+static void ans1_dorme(struct ans1 *ans);
+static void ans1_cpu_stop(struct ans1 *ans);
+static void ans1_init_iboot(struct ans1 *ans);
+static int ans1_sync(struct ans1 *ans, u8 op, u16 flags, const struct ans1_campo *campos, int n);
+
+/*
+ * Depois de cada partida (carga do driver ou flush): o que o iBoot manda antes da
+ * primeira E/S, e a liberação da escrita. O firmware parte trancado: sem o 0x19,
+ * a primeira escrita derruba o ANS ("host_ios.c:171", sinalizador de escrita).
+ */
+static int ans1_configura(struct ans1 *ans)
+{
+	int ret;
+
+	ktime_t t0 = ktime_get();
+
+	if (init_iboot)
+		ans1_init_iboot(ans);
+	if (depura)
+		dev_info(ans->dev, "init_iboot em %lld ms\n", ktime_ms_delta(ktime_get(), t0));
+	ret = ans1_sync(ans, ANS1_OP_ABRE_IO, 0, NULL, 0);
+	if (depura)
+		dev_info(ans->dev, "0x1b (abre E/S) em %lld ms\n", ktime_ms_delta(ktime_get(), t0));
+	if (ret)
+		return ret;
+	if (escrita_ate > escrita_de)
+		ret = ans1_sync(ans, ANS1_OP_WRITE_UNLOCK, 0, NULL, 0);
+	return ret;
+}
+
+/* com ans->estado: põe para dormir (salva o contexto do FTL) */
+static int ans1_adormece(struct ans1 *ans)
+{
+	ktime_t t0 = ktime_get();
+	int ret;
+
+	if (ans->dormindo || READ_ONCE(ans->morto))
+		return READ_ONCE(ans->morto) ? -EIO : 0;
+	ret = apple_rtkit_shutdown(ans->rtk);
+	if (ret) {
+		WRITE_ONCE(ans->morto, true);
+		dev_err(ans->dev, "o ANS não confirmou que dormiu (%d): dados recentes em risco\n", ret);
+		return ret;
+	}
+	ans1_cpu_stop(ans);
+	ans->dormindo = true;
+	WRITE_ONCE(ans->flush_pendente, false);
+	ans->dormiu++;
+	if (depura)
+		dev_info(ans->dev, "dormiu em %lld ms\n", ktime_ms_delta(ktime_get(), t0));
+	return 0;
+}
+
+/* com ans->estado: firmware limpo, partida, buffers, configuração */
+static int ans1_acorda(struct ans1 *ans)
+{
+	ktime_t t0 = ktime_get();
+	int ret;
+
+	if (!ans->dormindo)
+		return 0;
+	if (READ_ONCE(ans->morto))
+		return -EIO;
+	ret = ans1_boot(ans, true);
+	if (depura)
+		dev_info(ans->dev, "partida em %lld ms\n", ktime_ms_delta(ktime_get(), t0));
+	if (!ret)
+		ret = ans1_configura(ans);
+	if (ret) {
+		WRITE_ONCE(ans->morto, true);
+		dev_err(ans->dev, "o ANS não acordou (%d)\n", ret);
+		return ret;
+	}
+	ans->dormindo = false;
+	ans->acordou++;
+	if (depura)
+		dev_info(ans->dev, "acordou em %lld ms\n", ktime_ms_delta(ktime_get(), t0));
+	return 0;
+}
+
+/* sem pedidos há cochilo_ms: espera os que estão em andamento e dorme */
+static void ans1_cochilo(struct work_struct *w)
+{
+	struct ans1 *ans = container_of(to_delayed_work(w), struct ans1, cochilo);
+	unsigned int memflags;
+
+	if (READ_ONCE(ans->saindo) || !ans->disk)
+		return;
+	memflags = blk_mq_freeze_queue(ans->disk->queue);
+	mutex_lock(&ans->estado);
+	ans1_adormece(ans);
+	mutex_unlock(&ans->estado);
+	blk_mq_unfreeze_queue(ans->disk->queue, memflags);
+}
+
+static void ans1_agenda_cochilo(struct ans1 *ans)
+{
+	unsigned int ms = READ_ONCE(cochilo_ms);
+
+	if (READ_ONCE(ans->flush_pendente))
+		ms = READ_ONCE(cochilo_flush_ms) ?: 1;
+	if (ms && !READ_ONCE(ans->saindo))
+		mod_delayed_work(system_wq, &ans->cochilo, msecs_to_jiffies(ms));
+}
+
+static void *ans1_bounce(struct ans1 *ans, unsigned int tag)
+{
+	return ans->bounce.v + (size_t)tag * ANS1_MAX_PAGES * ANS1_PAGE;
+}
+
+static blk_status_t ans1_queue_rq(struct blk_mq_hw_ctx *hctx,
+				  const struct blk_mq_queue_data *bd)
+{
+	struct request *rq = bd->rq;
+	struct ans1 *ans = hctx->queue->queuedata;
+	struct ans1_rq *arq = blk_mq_rq_to_pdu(rq);
+	struct ans1_cmd_hdr *cmd = ans1_cmd(ans, rq->tag);
+	dma_addr_t b = ans->bounce.fis + (dma_addr_t)rq->tag * ANS1_MAX_PAGES * ANS1_PAGE;
+	unsigned int bytes = blk_rq_bytes(rq), npag = bytes / ANS1_PAGE, i;
+	u8 op;
+
+	if (READ_ONCE(ans->morto))
+		return BLK_STS_IOERR;
+
+	if (req_op(rq) == REQ_OP_FLUSH) {
+		/* ver cochilo_flush_ms: por padrão só agenda o dormir */
+		int ret = 0;
+
+		blk_mq_start_request(rq);
+		if (READ_ONCE(flush_espera)) {
+			mutex_lock(&ans->estado);
+			ret = ans1_adormece(ans);
+			mutex_unlock(&ans->estado);
+		} else if (!ans->dormindo) {
+			WRITE_ONCE(ans->flush_pendente, true);
+			ans1_agenda_cochilo(ans);
+		}
+		blk_mq_end_request(rq, ret ? BLK_STS_IOERR : BLK_STS_OK);
+		return BLK_STS_OK;
+	}
+
+	mutex_lock(&ans->estado);
+	if (ans1_acorda(ans)) {
+		mutex_unlock(&ans->estado);
+		return BLK_STS_IOERR;
+	}
+	mutex_unlock(&ans->estado);
+
+	switch (req_op(rq)) {
+	case REQ_OP_READ:
+		op = ANS1_OP_READ;
+		break;
+	case REQ_OP_WRITE: {
+		u64 ini = blk_rq_pos(rq) >> 3, fim = ini + npag;
+
+		if (!escrita || ini < escrita_de || fim > escrita_ate) {
+			dev_err_ratelimited(ans->dev,
+					    "escrita RECUSADA nos blocos %llu..%llu (janela %lu..%lu)\n",
+					    ini, fim, escrita_de, escrita_ate);
+			return BLK_STS_IOERR;
+		}
+		op = ANS1_OP_WRITE;
+		break;
+	}
+	default:
+		return BLK_STS_NOTSUPP;
+	}
+	if (!npag || bytes % ANS1_PAGE || npag > ANS1_MAX_PAGES) {
+		dev_err_ratelimited(ans->dev, "pedido fora do formato (%u bytes)\n", bytes);
+		return BLK_STS_IOERR;
+	}
+
+	if (op == ANS1_OP_WRITE) {	/* páginas do Linux -> buffer intermediário */
+		struct req_iterator it;
+		struct bio_vec bv;
+		char *d = ans1_bounce(ans, rq->tag);
+
+		rq_for_each_segment(bv, rq, it) {
+			void *src = bvec_kmap_local(&bv);
+
+			memcpy_toio((void __iomem *)d, src, bv.bv_len);
+			kunmap_local(src);
+			d += bv.bv_len;
+		}
+	}
+
+	/*
+	 * Bloco nunca escrito (ou apagado por TRIM): o ANS responde OK sem escrever
+	 * nada (ans1.py: "trimmed request appears to be SUCCESS so must zero
+	 * beforehand"). Sem zerar, a leitura devolveria o resto do pedido anterior.
+	 */
+	if (op == ANS1_OP_READ)
+		memset_io((void __iomem *)ans1_bounce(ans, rq->tag), 0, bytes);
+
+	memset_io((void __iomem *)cmd, 0, ANS1_CMD_SIZE);
+	for (i = 0; i < npag; i++)
+		cmd->pages[i] = cpu_to_le32((b + i * ANS1_PAGE) >> 12);
+	cmd->op = op;
+	cmd->tag = rq->tag;
+	cmd->flags = cpu_to_le16(ANS1_FLAG_NO_ENCRYPTION);
+	cmd->slba = cpu_to_le32(blk_rq_pos(rq) >> 3);	/* setores de 512 -> LBAs de 4 KB */
+	cmd->length = cpu_to_le32(npag);
+
+	if (depura)
+		dev_info(ans->dev, "cmd tag %u: op %#x slba %u len %u\n",
+			 cmd->tag, cmd->op, le32_to_cpu(cmd->slba), npag);
+	arq->status = BLK_STS_OK;
+	blk_mq_start_request(rq);
+	if (ans1_ring(ans, rq->tag, true)) {
+		/* ANS travado: erro de verdade, senão o bloco fica reenviando para sempre */
+		if (apple_rtkit_is_crashed(ans->rtk)) {
+			WRITE_ONCE(ans->morto, true);
+			blk_mq_end_request(rq, BLK_STS_IOERR);
+			return BLK_STS_OK;
+		}
+		return BLK_STS_RESOURCE;
+	}
+	return BLK_STS_OK;
+}
+
+static void ans1_complete(struct request *rq)
+{
+	struct ans1 *ans = rq->q->queuedata;
+	struct ans1_rq *arq = blk_mq_rq_to_pdu(rq);
+
+	if (req_op(rq) == REQ_OP_READ && arq->status == BLK_STS_OK) {
+		struct req_iterator it;
+		struct bio_vec bv;
+		const char *o = ans1_bounce(ans, rq->tag);
+
+		dma_rmb();
+		rq_for_each_segment(bv, rq, it) {	/* buffer intermediário -> páginas do Linux */
+			void *dst = bvec_kmap_local(&bv);
+
+			ans1_copia_dev(dst, o, bv.bv_len);
+			kunmap_local(dst);
+			o += bv.bv_len;
+		}
+		if (depura)
+			dev_info(ans->dev, "fim tag %d: %*ph\n", rq->tag, 16,
+				 (u8 *)ans1_bounce(ans, rq->tag));
+	}
+	blk_mq_end_request(rq, arq->status);
+	ans1_agenda_cochilo(ans);
+}
+
+static enum blk_eh_timer_return ans1_timeout(struct request *rq)
+{
+	struct ans1 *ans = rq->q->queuedata;
+
+	dev_err(ans->dev, "tag %d (setor %llu) sem resposta do ANS\n", rq->tag, blk_rq_pos(rq));
+	((struct ans1_rq *)blk_mq_rq_to_pdu(rq))->status = BLK_STS_TIMEOUT;
+	blk_mq_complete_request(rq);
+	return BLK_EH_DONE;
+}
+
+static const struct blk_mq_ops ans1_mq_ops = {
+	.queue_rq = ans1_queue_rq,
+	.complete = ans1_complete,
+	.timeout = ans1_timeout,
+};
+
+static const struct block_device_operations ans1_fops = {
+	.owner = THIS_MODULE,
+};
+
+/* ---------- partida ---------- */
+
+/* o m1n1 descreve o firmware que o iBoot deixou na RAM num nó reserved-memory */
+static int ans1_fw_region(struct ans1 *ans, u64 *phys, u64 *iova, u64 *size)
+{
+	struct device_node *rmem, *np;
+	int ret = -ENOENT;
+
+	rmem = of_find_node_by_path("/reserved-memory");
+	if (!rmem)
+		return ret;
+	for_each_child_of_node(rmem, np) {
+		const __be32 *p;
+		struct resource r;
+		int len;
+
+		if (!of_device_is_compatible(np, "apple,iop-mem"))
+			continue;
+		p = of_get_property(np, "iommu-addresses", &len);
+		if (!p || len < 5 * 4 || be32_to_cpup(p) != ans->dev->of_node->phandle)
+			continue;
+		if (of_address_to_resource(np, 0, &r))
+			continue;
+		*phys = r.start;
+		*iova = of_read_number(p + 1, 2);
+		*size = of_read_number(p + 3, 2);
+		ret = 0;
+		of_node_put(np);
+		break;
+	}
+	of_node_put(rmem);
+	return ret;
+}
+
+static void ans1_cpu_stop(struct ans1 *ans)
+{
+	writel(readl(ans->cpu + AKF_CPU_CONTROL) & ~AKF_CPU_CONTROL_START,
+	       ans->cpu + AKF_CPU_CONTROL);
+}
+
+/* estado do IOP e das filas do mailbox (reg+0x1000), para quando algo não responde */
+static void ans1_diag(struct ans1 *ans, const char *quando)
+{
+	struct resource *r = platform_get_resource(to_platform_device(ans->dev), IORESOURCE_MEM, 0);
+	void __iomem *mb = r ? ioremap(r->start + 0x1000, 0x1000) : NULL;
+
+	dev_info(ans->dev, "diag (%s): cpu_control=%#x remap phys=%#x%08x size=%#x",
+		 quando, readl(ans->cpu + AKF_CPU_CONTROL), readl(ans->cpu + AKF_REMAP_PHYS_HI),
+		 readl(ans->cpu + AKF_REMAP_PHYS_LO), readl(ans->cpu + AKF_REMAP_SIZE_LO));
+	if (mb) {
+		dev_info(ans->dev, "diag (%s): a2i_ctl=%#x i2a_ctl=%#x (bit17 = fila vazia)\n",
+			 quando, readl(mb + 0x08), readl(mb + 0x20));
+		iounmap(mb);
+	}
+}
+
+/* deixa o ANS como o iBoot deixa: dormindo de forma limpa e com a CPU parada */
+static void ans1_dorme(struct ans1 *ans)
+{
+	int ret = apple_rtkit_shutdown(ans->rtk);
+
+	if (ret) {
+		dev_warn(ans->dev, "o ANS não confirmou que dormiu (%d); a CPU fica ligada\n", ret);
+		return;
+	}
+	ans1_cpu_stop(ans);
+	dev_info(ans->dev, "ANS dormindo, CPU parada\n");
+}
+
+/* acorda o ANS pelo RTKit e entrega o buffer de comandos (depois da partida ou do sono) */
+static int ans1_conecta(struct ans1 *ans)
+{
+	int ret;
+
+	/* "acorde" (INIT): ele responde HELLO; vale para partida a frio e para sono */
+	reinit_completion(&ans->ready);
+	reinit_completion(&ans->cmdbuf_ready);
+	ret = apple_rtkit_wake(ans->rtk);
+	if (ret) {
+		ans1_diag(ans, "falhou");
+		return dev_err_probe(ans->dev, ret, "RTKit não subiu\n");
+	}
+
+	/* o endpoint já foi ligado pelo RTKit (early_app_endpoints) */
+	if (!ans->ep)
+		ans->ep = apple_rtkit_app_ep_to_ep(ans->rtk, 0);
+	if (!wait_for_completion_timeout(&ans->ready, ANS1_TIMEOUT))
+		return dev_err_probe(ans->dev, -ETIMEDOUT, "o ANS não ficou pronto\n");
+
+	ret = ans1_send(ans, FIELD_PREP(ANS1_CMDBUF_BASE, ans->cmdb.fis) |
+			     FIELD_PREP(ANS1_CMDBUF_SIZE_17_6, (ntags * ANS1_CMD_SIZE) >> 6) |
+			     FIELD_PREP(ANS1_MSG_TYPE, ANS1_MSG_SET_CMDBUF), false);
+	if (ret)
+		return ret;
+	if (!wait_for_completion_timeout(&ans->cmdbuf_ready, ANS1_TIMEOUT))
+		return dev_err_probe(ans->dev, -ETIMEDOUT, "o ANS não aceitou o buffer\n");
+
+	for (unsigned int t = 0; t < ntags; t++) {
+		ret = ans1_send(ans, FIELD_PREP(ANS1_TAG_TAG, t) |
+				     FIELD_PREP(ANS1_TAG_OFF_17_6, (t * ANS1_CMD_SIZE) >> 6) |
+				     FIELD_PREP(ANS1_TAG_SIZE_17_6, ANS1_CMD_SIZE >> 6) |
+				     FIELD_PREP(ANS1_MSG_TYPE, ANS1_MSG_SET_TAG), false);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int ans1_boot(struct ans1 *ans, bool silencioso)
+{
+	u64 phys, iova, size;
+	int ret;
+
+	ret = ans1_fw_region(ans, &phys, &iova, &size);
+	if (ret)
+		return dev_err_probe(ans->dev, ret,
+				     "sem o firmware do ANS (o m1n1 passa ele pelo alias 'asp')\n");
+	if (!silencioso)
+		dev_info(ans->dev, "firmware do iBoot em %#llx (%#llx bytes)\n", phys, size);
+
+	writel(lower_32_bits(iova), ans->cpu + AKF_REMAP_IOVA_LO);
+	writel(upper_32_bits(iova), ans->cpu + AKF_REMAP_IOVA_HI);
+	writel(lower_32_bits(phys), ans->cpu + AKF_REMAP_PHYS_LO);
+	writel(upper_32_bits(phys), ans->cpu + AKF_REMAP_PHYS_HI);
+	writel(lower_32_bits(size), ans->cpu + AKF_REMAP_SIZE_LO);
+	writel(upper_32_bits(size), ans->cpu + AKF_REMAP_SIZE_HI);
+	writel(1, ans->cpu + AKF_ENDIANNESS);
+	writel(0, ans->cpu + AKF_UNK_80C);
+
+	/*
+	 * Ciclo do m1n1 (e do iBoot): dormir (AP quieto + IOP dormindo, com
+	 * confirmação) e SÓ ENTÃO parar a CPU; daí a partida funciona. Parar a CPU
+	 * no meio do uso deixa o __DATA do firmware inconsistente e ele trava
+	 * ("anc_queue.c:62 assert failed: Queue underflow"). O iBoot e o nosso
+	 * remove() deixam a CPU parada; se ela está rodando, alguém a deixou ligada.
+	 */
+	if (readl(ans->cpu + AKF_CPU_CONTROL) & AKF_CPU_CONTROL_START) {
+		if (!silencioso)
+			dev_info(ans->dev, "a CPU do ANS já está rodando: pondo para dormir antes\n");
+		ret = apple_rtkit_shutdown(ans->rtk);
+		if (ret)
+			dev_warn(ans->dev, "o ANS não confirmou que dormiu (%d); tentando assim mesmo\n",
+				 ret);
+		ans1_cpu_stop(ans);
+		msleep(50);
+	}
+	if (ans->fw) {
+		/*
+		 * Imagem original: __TEXT + __DATA inicial, o resto da região zerado. O
+		 * começo do __DATA é uma tabela de parâmetros que o iBoot preenche (SOC_,
+		 * SOCR, McRA, ANCC = clock do barramento da flash, RHB0/RHS0 = área de
+		 * trabalho...): sem ela o firmware trava ("anc_link_clk_hz != 0"). Então a
+		 * tabela da cópia atual é preservada.
+		 */
+		void __iomem *r = ioremap(phys, size);
+		u8 tab[ANS1_TAB_MAX];
+		size_t ntab;
+
+		if (!r)
+			return dev_err_probe(ans->dev, -ENOMEM, "não mapeei a região do firmware\n");
+		memcpy_fromio(tab, r + ANS1_DATA, sizeof(tab));
+		ntab = ans1_tabela_tam(tab, sizeof(tab));
+		memcpy_toio(r, ans->fw, ans->fw_tam);
+		memset_io(r + ans->fw_tam, 0, size - ans->fw_tam);
+		memcpy_toio(r + ANS1_DATA, tab, ntab);
+		iounmap(r);
+		if (!silencioso)
+			dev_info(ans->dev, "firmware limpo recarregado (%zu bytes)\n", ans->fw_tam);
+	}
+	writel(readl(ans->cpu + AKF_CPU_CONTROL) | AKF_CPU_CONTROL_START,
+	       ans->cpu + AKF_CPU_CONTROL);
+
+	ret = ans1_conecta(ans);
+	if (ret)
+		return ret;
+	if (!silencioso)
+		dev_info(ans->dev, "ANS pronto (endpoint %u, %u tag(s))\n", ans->ep, ntags);
+	return 0;
+}
+
+static int ans1_identify(struct ans1 *ans)
+{
+	u32 *r = (u32 *)ans1_cmd(ans, 0);
+	int ret;
+
+	/* a resposta volta no próprio buffer de comando; tenta de novo se vier incompleta */
+	for (int t = 0; t < 4; t++) {
+		ret = ans1_sync(ans, ANS1_OP_IDENTIFY, 0, NULL, 0);
+		if (ret)
+			return ret;
+		ans->nr_lba = le32_to_cpu(READ_ONCE(r[0x30 / 4]));
+		ans->lba_size = le32_to_cpu(READ_ONCE(r[0x34 / 4]));
+		if (ans->nr_lba && ans->lba_size)
+			break;
+		dev_info(ans->dev, "identify veio incompleto (tentativa %d)\n", t + 1);
+		msleep(20);
+	}
+	dev_info(ans->dev, "flash: %llu blocos de %u bytes = %llu MB (%u blocos brutos)\n",
+		 ans->nr_lba, ans->lba_size, (ans->nr_lba * ans->lba_size) >> 20,
+		 le32_to_cpu(r[0x48 / 4]));
+	if (!ans->nr_lba || ans->lba_size != ANS1_PAGE) {
+		print_hex_dump(KERN_ERR, "identify: ", DUMP_PREFIX_OFFSET, 16, 4, r, 0x80, false);
+		return -ENODEV;
+	}
+	return 0;
+}
+
+static int ans1_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct queue_limits lim = {
+		.logical_block_size = ANS1_PAGE,
+		.physical_block_size = ANS1_PAGE,
+		.io_min = ANS1_PAGE,
+		.max_hw_sectors = ANS1_MAX_PAGES * (ANS1_PAGE >> SECTOR_SHIFT),
+		.max_segments = ANS1_MAX_PAGES,
+		/* o ANS só garante o que foi escrito depois de dormir: o Linux manda flush */
+		.features = BLK_FEAT_WRITE_CACHE,
+	};
+	struct ans1 *ans;
+	int ret;
+
+	if (ntags < 1 || ntags > ANS1_MAX_TAGS)
+		return dev_err_probe(dev, -EINVAL, "ntags precisa ser 1..%d\n", ANS1_MAX_TAGS);
+
+	ans = devm_kzalloc(dev, sizeof(*ans), GFP_KERNEL);
+	if (!ans)
+		return -ENOMEM;
+	ans->dev = dev;
+	platform_set_drvdata(pdev, ans);
+	init_completion(&ans->ready);
+	init_completion(&ans->cmdbuf_ready);
+	init_completion(&ans->sync_done);
+	mutex_init(&ans->estado);
+	INIT_DELAYED_WORK(&ans->cochilo, ans1_cochilo);
+
+	/*
+	 * O RTKit aloca os buffers de log/crashlog do ANS pela API de DMA; sem isto a
+	 * máscara padrão (32 bits) não alcança a RAM do A8 (que começa em 0x8_0000_0000).
+	 */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(44));
+	if (ret)
+		return ret;
+
+	ans->cpu = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ans->cpu))
+		return PTR_ERR(ans->cpu);
+
+	/* o firmware exige o buffer de comandos alinhado à página ("mbox.c:136 assert") */
+	ret = ans1_buf_aloca(&ans->cmdb, ntags * ANS1_CMD_SIZE);
+	if (!ret)
+		ret = devm_add_action_or_reset(dev, ans1_buf_libera, &ans->cmdb);
+	if (!ret)
+		ret = ans1_buf_aloca(&ans->bounce, (size_t)ntags * ANS1_MAX_PAGES * ANS1_PAGE);
+	if (!ret)
+		ret = devm_add_action_or_reset(dev, ans1_buf_libera, &ans->bounce);
+	if (ret)
+		return dev_err_probe(dev, ret, "sem memória para os buffers do ANS\n");
+	ans1_varre();
+
+	if (fw_limpo) {
+		const struct firmware *f;
+
+		if (!request_firmware(&f, ANS1_FW_NOME, dev)) {
+			if (f->size > 0x4a000 && f->size < SZ_1M) {
+				ans->fw = devm_kmemdup(dev, f->data, f->size, GFP_KERNEL);
+				ans->fw_tam = f->size;
+			}
+			release_firmware(f);
+		}
+		if (!ans->fw)
+			dev_warn(dev, "sem %s: usando a cópia do iBoot (escrita pouco confiável)\n",
+				 ANS1_FW_NOME);
+	}
+	if (!ans->fw && escrita_ate > escrita_de) {
+		dev_warn(dev, "sem o firmware limpo a escrita não é segura: disco só leitura\n");
+		escrita_ate = escrita_de;
+	}
+
+	ans->rtk = devm_apple_rtkit_init(dev, ans, NULL, 0, &ans1_rtkit_ops);
+	if (IS_ERR(ans->rtk))
+		return dev_err_probe(dev, PTR_ERR(ans->rtk), "RTKit/mailbox\n");
+
+	ret = ans1_boot(ans, false);
+	if (ret) {
+		/* não deixa o ANS ligado e escrevendo log em buffers que vão ser liberados */
+		if (apple_rtkit_is_running(ans->rtk))
+			ans1_dorme(ans);
+		return ret;
+	}
+	ret = ans1_identify(ans);
+	if (ret)
+		goto desliga;
+	ret = ans1_configura(ans);
+	if (ret) {
+		dev_err(dev, "configuração depois da partida falhou: %d\n", ret);
+		goto desliga;
+	}
+
+	ans->tagset.ops = &ans1_mq_ops;
+	ans->tagset.nr_hw_queues = 1;
+	ans->tagset.queue_depth = ntags;
+	ans->tagset.numa_node = NUMA_NO_NODE;
+	ans->tagset.cmd_size = sizeof(struct ans1_rq);
+	ans->tagset.timeout = ANS1_TIMEOUT;
+	ans->tagset.driver_data = ans;
+	ans->tagset.flags = BLK_MQ_F_BLOCKING;	/* o flush espera o ANS reiniciar */
+	ret = blk_mq_alloc_tag_set(&ans->tagset);
+	if (ret)
+		goto desliga;
+
+	ans->disk = blk_mq_alloc_disk(&ans->tagset, &lim, ans);
+	if (IS_ERR(ans->disk)) {
+		ret = PTR_ERR(ans->disk);
+		ans->disk = NULL;
+		goto tagset;
+	}
+	strscpy(ans->disk->disk_name, "ans0", DISK_NAME_LEN);
+	ans->disk->fops = &ans1_fops;
+	ans->disk->private_data = ans;
+	/* minors = 0: sem major próprio, o kernel escolhe os números (partições incluídas) */
+	set_capacity(ans->disk, ans->nr_lba * (ANS1_PAGE >> SECTOR_SHIFT));
+	set_disk_ro(ans->disk, !escrita);
+
+	ret = add_disk(ans->disk);
+	if (ret)
+		goto disco;
+	if (escrita)
+		dev_info(dev, "disco ans0 pronto: escrita SÓ nos blocos %lu..%lu (%lu MB), "
+			 "cochilo %u ms\n", escrita_de, escrita_ate, (escrita_ate - escrita_de) >> 8,
+			 cochilo_ms);
+	else
+		dev_info(dev, "disco ans0 pronto (só leitura)\n");
+	ans1_agenda_cochilo(ans);
+	return 0;
+
+disco:
+	put_disk(ans->disk);
+	ans->disk = NULL;
+tagset:
+	blk_mq_free_tag_set(&ans->tagset);
+desliga:
+	ans1_dorme(ans);
+	return ret;
+}
+
+static void ans1_remove(struct platform_device *pdev)
+{
+	struct ans1 *ans = platform_get_drvdata(pdev);
+
+	WRITE_ONCE(ans->saindo, true);
+	cancel_delayed_work_sync(&ans->cochilo);
+	del_gendisk(ans->disk);			/* manda o último flush (ANS dorme) */
+	put_disk(ans->disk);
+	blk_mq_free_tag_set(&ans->tagset);
+	if (!ans->dormindo)
+		ans1_dorme(ans);
+	dev_info(ans->dev, "ANS dormindo, CPU parada (acordou %u vezes, dormiu %u)\n",
+		 ans->acordou, ans->dormiu);
+}
+
+static const struct of_device_id ans1_of_match[] = {
+	{ .compatible = "apple,ans1" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, ans1_of_match);
+
+static struct platform_driver ans1_driver = {
+	.driver = {
+		.name = "apple-ans1",
+		.of_match_table = ans1_of_match,
+	},
+	.probe = ans1_probe,
+	.remove = ans1_remove,
+};
+module_platform_driver(ans1_driver);
+
+MODULE_DESCRIPTION("Armazenamento interno Apple A7/A8 (ANS1) - Linux-no-iphone-6");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/block/Kconfig b/drivers/block/Kconfig
index 858320b..0cb4b22 100644
--- a/drivers/block/Kconfig
+++ b/drivers/block/Kconfig
@@ -372,4 +372,14 @@ config BLK_DEV_ZONED_LOOP
 
 	  If unsure, say N.
 
+config BLK_DEV_APPLE_ANS1
+	tristate "Apple A7/A8 internal storage (ANS1)"
+	depends on ARCH_APPLE || COMPILE_TEST
+	depends on APPLE_RTKIT
+	help
+	  Internal flash of Apple A7/A8 devices (iPhone 5s/6, iPad Air 2...),
+	  driven through the ANS coprocessor ("ASP") over RTKit. Firmware is
+	  preloaded by iBoot and described to Linux by m1n1. Read-only unless
+	  the "escrita" module parameter is set.
+
 endif # BLK_DEV
diff --git a/drivers/block/Makefile b/drivers/block/Makefile
index 2d8096e..6a16f43 100644
--- a/drivers/block/Makefile
+++ b/drivers/block/Makefile
@@ -39,5 +39,6 @@ obj-$(CONFIG_BLK_DEV_RUST_NULL) += rnull/
 
 obj-$(CONFIG_BLK_DEV_UBLK)			+= ublk_drv.o
 obj-$(CONFIG_BLK_DEV_ZONED_LOOP) += zloop.o
+obj-$(CONFIG_BLK_DEV_APPLE_ANS1) += apple-ans1.o
 
