@@ -2139,6 +2139,15 @@ static int brcmf_pcie_read_otp(struct brcmf_pciedev_info *devinfo)
 	}
 
 	ret = brcmf_pcie_parse_otp(devinfo, (u8 *)otp, 2 * words);
