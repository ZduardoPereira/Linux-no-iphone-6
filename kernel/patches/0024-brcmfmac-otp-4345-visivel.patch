+			 devinfo->otp.version,
+			 devinfo->otp.valid ? "completo" : "incompleto");
+	if (optional && !devinfo->otp.valid)
+		print_hex_dump(KERN_INFO, "brcmfmac OTP: ", DUMP_PREFIX_OFFSET,
+			       16, 2, otp, 2 * words, false);
